# syntax=docker/dockerfile:1.7
FROM node:24.11.1-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json tsconfig.base.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY packages/shared packages/shared
RUN pnpm build:web

FROM nginxinc/nginx-unprivileged:1.29.1-alpine AS runtime
ARG WARKA_RELEASE_VERSION
ARG WARKA_REVISION
ARG WARKA_BUILD_CREATED
ARG WARKA_SOURCE_URL=https://github.com/tebibusolomonka-ops/Warka
LABEL org.opencontainers.image.title="Warka Web" \
  org.opencontainers.image.version=$WARKA_RELEASE_VERSION \
  org.opencontainers.image.revision=$WARKA_REVISION \
  org.opencontainers.image.created=$WARKA_BUILD_CREATED \
  org.opencontainers.image.source=$WARKA_SOURCE_URL
COPY deploy/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/web/entrypoint.sh /docker-entrypoint.d/40-warka-config.sh
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
USER root
RUN chmod 0555 /docker-entrypoint.d/40-warka-config.sh && \
  chown -R 101:101 /usr/share/nginx/html
USER 101
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/index.html"]
CMD ["nginx", "-g", "daemon off;"]
