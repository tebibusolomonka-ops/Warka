{
  "name": "warka",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @warka/web dev",
    "build:web": "pnpm build:shared && pnpm --filter @warka/web build",
    "typecheck:web": "pnpm typecheck:shared && pnpm --filter @warka/web typecheck",
    "dev:api": "pnpm --filter @warka/api dev",
    "build:api": "pnpm build:shared && pnpm build:database && pnpm --filter @warka/auth build && pnpm --filter @warka/api build",
    "typecheck:api": "pnpm build:shared && pnpm build:database && pnpm --filter @warka/auth build && pnpm --filter @warka/api typecheck",
    "test:api": "pnpm build:shared && pnpm build:database && pnpm --filter @warka/auth build && pnpm --filter @warka/api test",
    "build:shared": "pnpm --filter @warka/shared build",
    "typecheck:shared": "pnpm --filter @warka/shared typecheck",
    "test:web": "pnpm --filter @warka/web test",
    "db:generate": "pnpm --filter @warka/database generate",
    "db:validate": "pnpm --filter @warka/database validate",
    "typecheck:database": "pnpm --filter @warka/database typecheck",
    "build:database": "pnpm --filter @warka/database build",
    "test:database": "pnpm --filter @warka/database test",
    "db:deploy": "pnpm --filter @warka/database migrate:deploy",
    "db:preflight": "node scripts/db-preflight.mjs",
    "test": "pnpm build && pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "eslint apps packages tests playwright.config.ts",
    "format:check": "prettier --check package.json apps packages tests playwright.config.ts",
    "metrics:code": "node scripts/code-metrics.mjs",
    "i18n:check": "pnpm build:shared && node scripts/i18n-check.mjs",
    "ci:check": "node scripts/ci-check.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "security:dependencies": "node scripts/dependency-metadata.mjs",
    "security:sbom": "node scripts/security-sbom.mjs",
    "install:check": "node scripts/reproducible-install.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm db:deploy",
    "db:test": "pnpm db:generate && pnpm test:database",
    "auth:bootstrap": "pnpm db:generate && pnpm build:shared && pnpm build:database && pnpm --filter @warka/auth bootstrap",
    "build:auth": "pnpm build:shared && pnpm build:database && pnpm --filter @warka/auth build",
    "typecheck:auth": "pnpm build:shared && pnpm build:database && pnpm --filter @warka/auth typecheck",
    "test:auth": "pnpm build:shared && pnpm build:database && pnpm --filter @warka/auth test",
    "test:e2e": "pnpm build && playwright test",
    "test:load": "node scripts/load-harness.mjs",
    "test:load:config": "node --test scripts/load-harness.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cyclonedx/cdxgen": "12.8.5",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@types/autocannon": "^7.12.7",
    "autocannon": "^8.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.46.0",
    "yaml": "2.8.1"
  }
}
