generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  owner
  administrator
}

enum SchoolRole {
  administrator
  registrar
  teacher
  approver
}

enum ResultSetStatus {
  draft
  pending
  published
}

enum EnrollmentStatus {
  draft
  pending
  approved
  withdrawn
}

model Organization {
  id          String                   @id @default(uuid())
  name        String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  schools     School[]
  memberships OrganizationMembership[]
}

model School {
  resultSets          ResultSet[]
  publishedResults    PublishedResult[]
  learningMaterials   LearningMaterial[]
  announcements       Announcement[]
  id                  String               @id @default(uuid())
  organizationId      String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff               SchoolMembership[]
  academicYears       AcademicYear[]
  gradeLevels         GradeLevel[]
  subjects            Subject[]
  classes             SchoolClass[]
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  gradingPeriods      GradingPeriod[]
  assessments         Assessment[]
  marks               Mark[]
  gradingScheme       GradingScheme?

  @@index([organizationId])
}

model User {
  submittedResultSets     ResultSet[]              @relation("ResultSetSubmittedBy")
  publishedResultSets     ResultSet[]              @relation("ResultSetPublishedBy")
  resultCorrections       ResultCorrection[]
  learningMaterials       LearningMaterial[]
  announcements           Announcement[]
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  displayName             String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organizationMemberships OrganizationMembership[]
  schoolMemberships       SchoolMembership[]
  passwordCredential      PasswordCredential?
  studentAccess           StudentAccess?
  sessions                Session[]
  approvedEnrollments     Enrollment[]             @relation("EnrollmentApprovedBy")
  withdrawnEnrollments    Enrollment[]             @relation("EnrollmentWithdrawnBy")
  teachingAssignments     TeachingAssignment[]
  marks                   Mark[]
}

model OrganizationMembership {
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model SchoolMembership {
  userId    String
  schoolId  String
  role      SchoolRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@index([schoolId])
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AcademicYear {
  resultSets          ResultSet[]
  learningMaterials   LearningMaterial[]
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  startsOn            DateTime             @db.Date
  endsOn              DateTime             @db.Date
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes             SchoolClass[]
  teachingAssignments TeachingAssignment[]
  gradingPeriods      GradingPeriod[]
  enrollments         Enrollment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@index([schoolId, startsOn])
}

model GradeLevel {
  id          String        @id @default(uuid())
  schoolId    String
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes     SchoolClass[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
}

model SchoolClass {
  resultSets          ResultSet[]
  learningMaterials   LearningMaterial[]
  announcements       Announcement[]
  id                  String               @id @default(uuid())
  schoolId            String
  academicYearId      String
  gradeLevelId        String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear         @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel          GradeLevel           @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, academicYearId, gradeLevelId, name])
  @@unique([id, schoolId])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, gradeLevelId])
}

model Student {
  publishedResults PublishedResult[]
  id               String            @id @default(uuid())
  studentReference String            @unique
  givenName        String
  familyName       String?
  dateOfBirth      DateTime?         @db.Date
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  guardians        StudentGuardian[]
  studentAccess    StudentAccess?
  enrollments      Enrollment[]
  marks            Mark[]
}

model StudentAccess {
  id        String   @id @default(uuid())
  userId    String   @unique
  studentId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Guardian {
  id        String            @id @default(uuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  students  StudentGuardian[]
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Enrollment {
  publishedResults PublishedResult[]
  id               String            @id @default(uuid())
  studentId        String
  schoolId         String
  academicYearId   String
  gradeLevelId     String
  schoolClassId    String?
  status           EnrollmentStatus  @default(draft)
  approvedAt       DateTime?
  approvedById     String?
  withdrawnAt      DateTime?
  withdrawnById    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear      @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel       GradeLevel        @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass      SchoolClass?      @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Restrict)
  approvedBy       User?             @relation("EnrollmentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  withdrawnBy      User?             @relation("EnrollmentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  marks            Mark[]

  @@unique([studentId, schoolId, academicYearId])
  @@unique([id, schoolId, studentId])
  @@index([schoolId, academicYearId, status])
  @@index([schoolId, gradeLevelId])
  @@index([approvedById])
  @@index([withdrawnById])
}

model Subject {
  resultSets          ResultSet[]
  learningMaterials   LearningMaterial[]
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  code                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([id, schoolId])
}

model LearningMaterial {
  id               String    @id @default(uuid())
  schoolId         String
  academicYearId   String
  schoolClassId    String
  subjectId        String
  title            String
  description      String?
  resourceType     String
  resourceLocation String
  publishedAt      DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass      SchoolClass @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject          Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy        User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, academicYearId, schoolClassId, publishedAt])
  @@index([createdById, schoolId])
}

model Announcement {
  id            String @id @default(uuid())
  schoolId      String
  schoolClassId String?
  title         String
  body          String
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolClass   SchoolClass? @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy     User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, publishedAt, expiresAt])
  @@index([schoolClassId, schoolId])
  @@index([createdById, schoolId])
}

model TeachingAssignment {
  id             String       @id @default(uuid())
  schoolId       String
  userId         String
  academicYearId String
  schoolClassId  String
  subjectId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass    SchoolClass  @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([userId, schoolClassId, subjectId, academicYearId])
  @@index([schoolId, academicYearId, userId])
  @@index([schoolId, schoolClassId, subjectId])
}

model GradingPeriod {
  resultSets     ResultSet[]
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String
  startsOn       DateTime     @db.Date
  endsOn         DateTime     @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  assessments    Assessment[]

  @@unique([schoolId, academicYearId, name])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, startsOn])
}

model Assessment {
  id              String        @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  name            String
  maximumScore    Decimal       @db.Decimal(8, 2)
  weight          Decimal       @db.Decimal(5, 2)
  position        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass   @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject       @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  marks           Mark[]

  @@unique([id, schoolId])
  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, name], map: "Assessment_context_name_key")
  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, position], map: "Assessment_context_position_key")
  @@index([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId])
}

model Mark {
  id           String     @id @default(uuid())
  schoolId     String
  studentId    String
  enrollmentId String
  assessmentId String
  score        Decimal    @db.Decimal(8, 2)
  recordedById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment   Enrollment @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  assessment   Assessment @relation(fields: [assessmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  recordedBy   User       @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, assessmentId])
  @@index([schoolId, assessmentId])
  @@index([schoolId, studentId])
}

model GradingScheme {
  id        String      @id @default(uuid())
  schoolId  String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  bands     GradeBand[]
}

model GradeBand {
  id                String        @id @default(uuid())
  gradingSchemeId   String
  label             String
  minimumPercentage Decimal       @db.Decimal(5, 2)
  gradingScheme     GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@unique([gradingSchemeId, label])
  @@unique([gradingSchemeId, minimumPercentage])
  @@index([gradingSchemeId, minimumPercentage])
}

model ResultSet {
  id              String            @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  status          ResultSetStatus   @default(draft)
  submittedAt     DateTime?
  submittedById   String?
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear      @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod     @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass       @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject           @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  submittedBy     User?             @relation("ResultSetSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  publishedBy     User?             @relation("ResultSetPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  results         PublishedResult[]

  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId], map: "ResultSet_context_key")
  @@unique([id, schoolId])
  @@index([schoolId, status])
}

model PublishedResult {
  id                String             @id @default(uuid())
  schoolId          String
  resultSetId       String
  studentId         String
  enrollmentId      String
  percentage        Decimal            @db.Decimal(5, 2)
  gradeLabel        String
  currentPercentage Decimal            @db.Decimal(5, 2)
  currentGradeLabel String
  createdAt         DateTime           @default(now())
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  resultSet         ResultSet          @relation(fields: [resultSetId, schoolId], references: [id, schoolId], onDelete: Restrict)
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment        Enrollment         @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  corrections       ResultCorrection[]

  @@unique([resultSetId, enrollmentId])
  @@unique([id, schoolId])
  @@index([schoolId, studentId])
}

model ResultCorrection {
  id                 String          @id @default(uuid())
  schoolId           String
  publishedResultId  String
  previousPercentage Decimal         @db.Decimal(5, 2)
  previousGradeLabel String
  newPercentage      Decimal         @db.Decimal(5, 2)
  newGradeLabel      String
  reason             String
  actorId            String
  effectiveAt        DateTime        @default(now())
  publishedResult    PublishedResult @relation(fields: [publishedResultId, schoolId], references: [id, schoolId], onDelete: Restrict)
  actor              User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([schoolId, publishedResultId, effectiveAt])
}
