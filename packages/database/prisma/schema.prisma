  previousGradeLevelId     String?
  previousSchoolClassId    String?
  newAcademicYearId        String?
  newGradeLevelId          String?
  newSchoolClassId         String?
  createdAt                DateTime              @default(now())
  enrollment               Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  performedBy              User?                 @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([enrollmentId, effectiveAt])
  @@index([performedById])
}

model Subject {
  resultSets          ResultSet[]
  learningMaterials   LearningMaterial[]
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  code                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([id, schoolId])
}

model LearningMaterial {
  id               String       @id @default(uuid())
  schoolId         String
  academicYearId   String
  schoolClassId    String
  subjectId        String
  title            String
  description      String?
  resourceType     String
  resourceLocation String
  publishedAt      DateTime?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass      SchoolClass  @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject          Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy        User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, academicYearId, schoolClassId, publishedAt])
  @@index([createdById, schoolId])
