generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivacyRequestType {
  access
  correction
  restriction
  objection
}

enum PrivacyRequestStatus {
  submitted
  underReview
  approved
  rejected
  fulfilled
  cancelled
}

enum PrivacyRequesterKind {
  student
  guardian
}

enum PrivacyRestrictionCategory {
  parentPortalSharing
  publicDocumentVerification
}

enum PrivacyRestrictionState {
  active
  ended
  reviewRequired
}

enum CorrectionRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum StudentCorrectionField {
  givenName
  familyName
  dateOfBirth
}

enum AccountStatus {
  active
  suspended
  deactivated
}

enum OrganizationRole {
  owner
  administrator
}

enum SchoolRole {
  administrator
  registrar
  teacher
  approver
}

enum BureauRole {
  viewer
  reportManager
}

enum ReportingPeriodStatus {
  draft
  open
  closed
}

enum ReportingSubmissionStatus {
  draft
  submitted
  approved
  returned
}

enum VerificationResultStatus {
  active
  corrected
  withdrawn
  unavailable
}

enum ResultSetStatus {
  draft
  pending
  published
}

enum TransferStatus {
  requested
  approvedBySendingSchool
  acceptedByReceivingSchool
  rejected
  cancelled
}

enum DocumentType {
  reportCard
  transcript
}

enum DocumentRequestStatus {
  requested
  processing
  ready
  rejected
  cancelled
}

enum DocumentStatus {
  active
  corrected
  withdrawn
}

enum FamilySenderKind {
  guardian
  school
}

enum FamilyConversationRoute {
  teacher
  schoolOffice
}

enum FamilyConversationStatus {
  open
  closed
}

enum GuardianVerificationStatus {
  pending
  verified
  revoked
}

enum EnrollmentStatus {
  draft
  pending
  approved
  withdrawn
}

enum ProgressionPlanStatus {
  draft
  reviewed
  applied
  cancelled
}

enum ProgressionExceptionKind {
  missingTargetClass
  existingTargetEnrollment
  withdrawnSource
  unresolvedTransfer
  incompleteSource
  manualReview
}

enum ProgressionExceptionStatus {
  open
  resolved
}

enum ProgressionAction {
  promote
  repeat
  withdraw
  manualReview
}

enum SupportRequestCategory {
  account
  studentRecords
  academicResults
  documents
  reporting
  technical
}

enum SupportRequestSeverity {
  low
  normal
  high
  critical
}

enum SupportRequestStatus {
  open
  inProgress
  waitingForSchool
  resolved
  closed
}

enum TrainingType {
  schoolAdministration
  studentRegistration
  academicResults
  documentProcessing
}

enum TrainingStatus {
  assigned
  completed
  waived
}

enum SchoolContactRole {
  primary
  technical
  records
  emergency
}

enum OnboardingChecklistStatus {
  pending
  complete
  notApplicable
}

enum SchoolOnboardingStatus {
  notStarted
  inProgress
  readyForReview
  completed
  paused
}

enum AccountRecoveryStatus {
  pending
  completed
  expired
  cancelled
}

enum AcademicYearStatus {
  active
  closing
  closed
}

enum EnrollmentHistoryType {
  enrolled
  submitted
  approved
  classChanged
  gradeChanged
  promoted
  withdrawn
  reEnrolled
}

model Organization {
  id               String                   @id @default(uuid())
  name             String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  schools          School[]
  memberships      OrganizationMembership[]
  bureauAccesses   BureauAccess[]
  reportingPeriods ReportingPeriod[]
  retentionHolds   RetentionHold[]
}

enum BackupScope {
  database
}

enum BackupStatus {
  pending
  running
  completed
  failed
  verified
}

enum BackupVerificationResult {
  passed
  failed
}

enum RestoreRehearsalStatus {
  running
  succeeded
  failed
}

model School {
  resultSets                    ResultSet[]
  publishedResults              PublishedResult[]
  learningMaterials             LearningMaterial[]
  announcements                 Announcement[]
  id                            String                 @id @default(uuid())
  organizationId                String
  name                          String
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  organization                  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff                         SchoolMembership[]
  academicYears                 AcademicYear[]
  gradeLevels                   GradeLevel[]
  subjects                      Subject[]
  classes                       SchoolClass[]
  enrollments                   Enrollment[]
  teachingAssignments           TeachingAssignment[]
  gradingPeriods                GradingPeriod[]
  assessments                   Assessment[]
  marks                         Mark[]
  gradingScheme                 GradingScheme?
  issuedDocuments               IssuedDocument[]
  outgoingTransfers             TransferRequest[]      @relation("SendingTransfers")
  incomingTransfers             TransferRequest[]      @relation("ReceivingTransfers")
  verifiedGuardianRelationships StudentGuardian[]
  serviceAccess                 SchoolServiceAccess?
  familyConversations           FamilyConversation[]
  reportingRequirements         ReportingRequirement[]
  reportingSubmissions          ReportingSubmission[]
  verificationEvents            VerificationEvent[]
  importJobs                    ImportJob[]
  documentProfile              SchoolDocumentProfile?
  progressionPlans             ProgressionPlan[]
  documentRequests             DocumentRequest[]
  onboarding                   SchoolOnboarding?
  contacts                     SchoolContact[]
  trainingRecords              TrainingRecord[]
  correctionRequests           StudentCorrectionRequest[]
  enrollmentCorrectionRequests EnrollmentCorrectionRequest[]
  privacyRequests              PrivacyRequest[]
  processingRestrictions       ProcessingRestriction[]
  supportRequests              SupportRequest[]

  @@index([organizationId])
}

model User {
  createdBackups               BackupRecord[] @relation("BackupCreatedBy")
  performedRestoreRehearsals RestoreRehearsal[] @relation("RestoreRehearsalPerformedBy")
  submittedResultSets          ResultSet[]              @relation("ResultSetSubmittedBy")
  issuedDocuments              IssuedDocument[]
  requestedTransfers           TransferRequest[]
  approvedTransfers            TransferRequest[]        @relation("TransferApprovedBy")
  acceptedTransfers            TransferRequest[]        @relation("TransferAcceptedBy")
  rejectedTransfers            TransferRequest[]        @relation("TransferRejectedBy")
  cancelledTransfers           TransferRequest[]        @relation("TransferCancelledBy")
  correctedDocuments           IssuedDocument[]         @relation("DocumentCorrectedBy")
  withdrawnDocuments           IssuedDocument[]         @relation("DocumentWithdrawnBy")
  publishedResultSets          ResultSet[]              @relation("ResultSetPublishedBy")
  resultCorrections            ResultCorrection[]
  learningMaterials            LearningMaterial[]
  announcements                Announcement[]
  id                           String                   @id @default(uuid())
  email                        String                   @unique
  displayName                  String
  accountStatus                AccountStatus @default(active)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  organizationMemberships      OrganizationMembership[]
  schoolMemberships            SchoolMembership[]
  bureauAccesses               BureauAccess[]
  passwordCredential           PasswordCredential?
  studentAccess                StudentAccess?
  guardianVerifications        StudentGuardian[]        @relation("GuardianVerifiedBy")
  guardianRevocations          StudentGuardian[]        @relation("GuardianRevokedBy")
  schoolServiceUpdates         SchoolServiceAccess[]
  familyMessages               FamilyMessage[]
  teacherConversations         FamilyConversation[]     @relation("FamilyConversationTeacher")
  closedFamilyConversations    FamilyConversation[]     @relation("FamilyConversationClosedBy")
  escalatedFamilyConversations FamilyConversation[]     @relation("FamilyConversationEscalatedBy")
  guardianAccess               GuardianAccess?
  recoveryRequests             AccountRecoveryRequest[]
  startedOnboardings            SchoolOnboarding[] @relation("OnboardingStartedBy")
  completedOnboardings          SchoolOnboarding[] @relation("OnboardingCompletedBy")
  completedChecklistItems       OnboardingChecklistItem[]
  trainingRecords               TrainingRecord[] @relation("TrainingUser")
  recordedTraining              TrainingRecord[] @relation("TrainingRecordedBy")
  createdSupportRequests        SupportRequest[] @relation("SupportRequestCreatedBy")
  assignedSupportRequests       SupportRequest[] @relation("SupportRequestAssignedTo")
  supportRequestMessages        SupportRequestMessage[]
  sessions                     Session[]
  supportIdentity              SupportIdentity?
  approvedEnrollments          Enrollment[]             @relation("EnrollmentApprovedBy")
  withdrawnEnrollments         Enrollment[]             @relation("EnrollmentWithdrawnBy")
  createdImportJobs            ImportJob[]
  requestedDocuments           DocumentRequest[]
  performedEnrollmentEvents    EnrollmentHistoryEvent[]
  closedAcademicYears          AcademicYear[] @relation("AcademicYearClosedBy")
  createdProgressionPlans      ProgressionPlan[] @relation("ProgressionPlanCreatedBy")
  reviewedProgressionPlans     ProgressionPlan[] @relation("ProgressionPlanReviewedBy")
  appliedProgressionPlans      ProgressionPlan[] @relation("ProgressionPlanAppliedBy")
  resolvedProgressionExceptions ProgressionException[] @relation("ProgressionExceptionResolvedBy")
  notifications                Notification[]
  teachingAssignments          TeachingAssignment[]
  requestedStudentCorrections  StudentCorrectionRequest[] @relation("StudentCorrectionRequestedBy")
  reviewedStudentCorrections   StudentCorrectionRequest[] @relation("StudentCorrectionReviewedBy")
  requestedEnrollmentCorrections EnrollmentCorrectionRequest[] @relation("EnrollmentCorrectionRequestedBy")
  reviewedEnrollmentCorrections  EnrollmentCorrectionRequest[] @relation("EnrollmentCorrectionReviewedBy")
  privacyRequests              PrivacyRequest[] @relation("PrivacyRequestRequester")
  reviewedPrivacyRequests      PrivacyRequest[] @relation("PrivacyRequestReviewer")
  approvedRestrictions         ProcessingRestriction[] @relation("RestrictionApprovedBy")
  endedRestrictions            ProcessingRestriction[] @relation("RestrictionEndedBy")
  createdRetentionHolds         RetentionHold[] @relation("RetentionHoldCreatedBy")
  releasedRetentionHolds        RetentionHold[] @relation("RetentionHoldReleasedBy")
  marks                        Mark[]
}

model BackupRecord {
  id               String       @id @default(uuid())
  scope            BackupScope  @default(database)
  status           BackupStatus @default(pending)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  createdById      String
  sizeBytes        BigInt?
  checksum         String?
  storageReference String?
  failureReason    String?
  verifiedAt       DateTime?
  verificationResult BackupVerificationResult?
  verificationReason String?
  createdBy        User         @relation("BackupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rehearsals       RestoreRehearsal[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model RestoreRehearsal {
  id String @id @default(uuid())
  backupId String
  startedAt DateTime @default(now())
  completedAt DateTime?
  status RestoreRehearsalStatus @default(running)
  failureReason String?
  performedById String
  backup BackupRecord @relation(fields: [backupId], references: [id], onDelete: Restrict)
  performedBy User @relation("RestoreRehearsalPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([backupId, startedAt])
  @@index([status, startedAt])
}

model OrganizationMembership {
  userId         String
  organizationId String
  role           OrganizationRole
  startsAt       DateTime         @default(now())
  endsAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model SchoolMembership {
  userId    String
  schoolId  String
  role      SchoolRole
  startsAt  DateTime   @default(now())
  endsAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@index([schoolId])
}

model BureauAccess {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           BureauRole
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role, revokedAt])
}

model ReportingPeriod {
  id              String                 @id @default(uuid())
  organizationId  String
  name            String
  startsOn        DateTime               @db.Date
  endsOn          DateTime               @db.Date
  submissionDueOn DateTime               @db.Date
  status          ReportingPeriodStatus  @default(draft)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements    ReportingRequirement[]
  submissions     ReportingSubmission[]

  @@unique([organizationId, name])
  @@index([organizationId, status, startsOn])
}

model ReportingRequirement {
  id                String          @id @default(uuid())
  reportingPeriodId String
  schoolId          String
  createdAt         DateTime        @default(now())
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([reportingPeriodId, schoolId])
  @@index([schoolId])
}

model ReportingSubmission {
  id                String                    @id @default(uuid())
  reportingPeriodId String
  schoolId          String
  status            ReportingSubmissionStatus @default(draft)
  snapshot          Json
  submittedAt       DateTime?
  submittedById     String?
  approvedAt        DateTime?
  approvedById      String?
  returnedAt        DateTime?
  returnedById      String?
  returnReason      String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  reportingPeriod   ReportingPeriod           @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([reportingPeriodId, schoolId])
  @@index([schoolId, status])
  @@index([reportingPeriodId, status])
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String?
  schoolId       String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now())

  @@index([organizationId, occurredAt])
  @@index([schoolId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, resourceType, occurredAt])
}

enum AccessReviewStatus {
  open
  completed
}

enum AccessReviewDecision {
  pending
  confirmed
  revoke
}

enum AccessReviewType {
  organizationMembership
  schoolMembership
  bureauAccess
}

model AccessReview {
  id             String              @id @default(uuid())
  organizationId String
  schoolId       String?
  startedById    String
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  completedById  String?
  status         AccessReviewStatus  @default(open)
  entries        AccessReviewEntry[]

  @@index([organizationId, status, startedAt])
  @@index([schoolId, status, startedAt])
}

model AccessReviewEntry {
  id             String               @id @default(uuid())
  accessReviewId String
  userId         String
  accessType     AccessReviewType
  organizationId String
  schoolId       String?
  currentRole    String
  sourceId       String?
  decision       AccessReviewDecision @default(pending)
  decidedById    String?
  decidedAt      DateTime?
  accessReview   AccessReview         @relation(fields: [accessReviewId], references: [id], onDelete: Cascade)

  @@unique([accessReviewId, accessType, userId, organizationId, schoolId])
  @@index([accessReviewId, decision])
  @@index([userId])
}

enum SupportAccessStatus {
  pending
  approved
  revoked
}

enum SupportAccessScope {
  schoolAdministrationDiagnostics
}

model SupportIdentity {
  userId    String   @id
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportAccessGrant {
  id            String              @id @default(uuid())
  supportUserId String
  schoolId      String
  scope         SupportAccessScope  @default(schoolAdministrationDiagnostics)
  reason        String
  status        SupportAccessStatus @default(pending)
  requestedAt   DateTime            @default(now())
  requestedById String
  approvedAt    DateTime?
  approvedById  String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedById   String?

  @@index([supportUserId, schoolId, status, expiresAt])
  @@index([schoolId, status, requestedAt])
}

enum RetentionCategory {
  messages
  auditEvents
  issuedDocuments
  academicRecords
  enrollmentRecords
}

model RetentionPolicy {
  id             String            @id @default(uuid())
  organizationId String
  category       RetentionCategory
  retentionDays  Int
  updatedById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId, updatedAt])
}

model PasswordCredential {
  userId             String   @id
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  managementId String @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SupportRequest {
  id          String                 @id @default(uuid())
  schoolId    String
  createdById String
  category    SupportRequestCategory
  severity    SupportRequestSeverity @default(normal)
  title       String
  description String
  status      SupportRequestStatus   @default(open)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  closedAt    DateTime?
  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("SupportRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedSupportUserId String?
  assignedSupportUser User? @relation("SupportRequestAssignedTo", fields: [assignedSupportUserId], references: [id], onDelete: SetNull)
  resolutionSummary String?
  messages SupportRequestMessage[]

  @@index([schoolId, status, createdAt])
  @@index([createdById, createdAt])
}

model SupportRequestMessage {
  id        String         @id @default(uuid())
  requestId String
  senderId  String
  body      String
  createdAt DateTime       @default(now())
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model TrainingRecord {
  id           String         @id @default(uuid())
  schoolId     String
  userId       String
  trainingType TrainingType
  status       TrainingStatus @default(assigned)
  completedAt  DateTime?
  recordedById String
  waiverReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User           @relation("TrainingUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy   User           @relation("TrainingRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId, trainingType])
  @@index([schoolId, status])
}

model SchoolContact {
  id        String            @id @default(uuid())
  schoolId  String
  name      String
  role      SchoolContactRole
  email     String?
  phone     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, role])
}

model SchoolOnboarding {
  id            String                 @id @default(uuid())
  schoolId      String                 @unique
  status        SchoolOnboardingStatus @default(notStarted)
  startedAt     DateTime?
  startedById   String?
  completedAt   DateTime?
  completedById String?
  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  startedBy     User?                  @relation("OnboardingStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  completedBy   User?                  @relation("OnboardingCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  checklistItems OnboardingChecklistItem[]
}

model OnboardingChecklistItem {
  id            String                    @id @default(uuid())
  onboardingId  String
  key           String
  status        OnboardingChecklistStatus @default(pending)
  completedAt   DateTime?
  completedById String?
  onboarding    SchoolOnboarding          @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  completedBy   User?                     @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([onboardingId, key])
}

model LoginAttemptBucket {
  emailHash      String   @id
  failures       Int      @default(0)
  windowStartsAt DateTime
  blockedUntil   DateTime?
  updatedAt      DateTime @updatedAt

  @@index([blockedUntil])
}

model AccountRecoveryRequest {
  id          String                @id @default(uuid())
  userId      String
  status      AccountRecoveryStatus @default(pending)
  createdAt   DateTime              @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  cancelledAt DateTime?
  tokenHash   String?               @unique
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model AcademicYear {
  status              AcademicYearStatus @default(active)
  closingStartedAt    DateTime?
  closedAt            DateTime?
  closedById          String?
  closedBy            User? @relation("AcademicYearClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  resultSets          ResultSet[]
  issuedDocuments     IssuedDocument[]
  documentRequests    DocumentRequest[]
  sourceProgressionPlans ProgressionPlan[] @relation("ProgressionSourceYear")
  targetProgressionPlans ProgressionPlan[] @relation("ProgressionTargetYear")
  learningMaterials   LearningMaterial[]
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  startsOn            DateTime             @db.Date
  endsOn              DateTime             @db.Date
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes             SchoolClass[]
  teachingAssignments TeachingAssignment[]
  gradingPeriods      GradingPeriod[]
  enrollments         Enrollment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@index([schoolId, startsOn])
  @@index([schoolId, status])
}

model GradeLevel {
  id          String        @id @default(uuid())
  schoolId    String
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes     SchoolClass[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
}

model SchoolClass {
  resultSets          ResultSet[]
  learningMaterials   LearningMaterial[]
  announcements       Announcement[]
  id                  String               @id @default(uuid())
  schoolId            String
  academicYearId      String
  gradeLevelId        String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear         @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel          GradeLevel           @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, academicYearId, gradeLevelId, name])
  @@unique([id, schoolId])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, gradeLevelId])
}

model Student {
  transferRequests    TransferRequest[]
  issuedDocuments     IssuedDocument[]
  documentRequests    DocumentRequest[]
  publishedResults    PublishedResult[]
  progressionEntries  ProgressionEntry[]
  id                  String               @id @default(uuid())
  studentReference    String               @unique
  givenName           String
  familyName          String?
  dateOfBirth         DateTime?            @db.Date
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  guardians           StudentGuardian[]
  familyConversations FamilyConversation[]
  studentAccess       StudentAccess?
  enrollments         Enrollment[]
  marks               Mark[]
  correctionRequests  StudentCorrectionRequest[]
  privacyRequests     PrivacyRequest[]
  processingRestrictions ProcessingRestriction[]
  retentionHolds RetentionHold[]
}

model StudentCorrectionRequest {
  id             String                  @id @default(uuid())
  studentId      String
  schoolId       String
  field          StudentCorrectionField
  previousValue  String?
  proposedValue  String?
  reason         String
  status         CorrectionRequestStatus @default(pending)
  requestedById  String
  requestedAt    DateTime                @default(now())
  reviewReason   String?
  effectiveAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  student        Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school         School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  requestedBy    User                    @relation("StudentCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                   @relation("StudentCorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  privacyRequests PrivacyRequest[]

  @@index([schoolId, status, requestedAt])
  @@index([studentId, requestedAt])
}

model StudentAccess {
  id        String   @id @default(uuid())
  userId    String   @unique
  studentId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
