model Organization {
  importSourceProfiles ImportSourceProfile[]
  id               String                   @id @default(uuid())
  name             String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  schools          School[]
  memberships      OrganizationMembership[]
  bureauAccesses   BureauAccess[]
  reportingPeriods ReportingPeriod[]
  retentionHolds   RetentionHold[]
}

enum BackupScope {
  database
}

enum BackupStatus {
  pending
  running
  completed
  failed
  verified
  deleting
  deleted
}

enum BackupVerificationResult {
  passed
  failed
}

enum RestoreRehearsalStatus {
  running
  succeeded
  failed
}

enum BackupFrequency {
  daily
  weekly
}

enum ScheduledTaskType {
  backup
  backupVerification
  retentionEvaluation
  fileScan
  emailDelivery
}

enum ScheduledTaskStatus {
  pending
  running
  interrupted
  completed
  failed
  skipped
}

enum TaskRecoveryDisposition {
  safeToRetry
  needsReconciliation
  manualReview
}

enum RecoveryReviewStatus {
  open
  resolved
  dismissed
}

enum RecoveryDomain {
  scheduledTask
  emailDelivery
  fileScan
  backup
  restoreRehearsal
}

enum FileAssetPurpose {
  learningMaterial
  schoolBranding
  issuedDocument
  courseworkAssignment
  courseworkSubmission
  eventAttachment
}

enum FileAssetStatus {
  pending
  available
  quarantined
  deleted
}

enum FileScanStatus {
  pending
  scanning
  clean
  infected
  failed
  unavailable
}

enum FileScanResult {
  clean
  infected
}

enum OperationalIncidentSeverity {
  low
  medium
  high
  critical
}

enum OperationalIncidentStatus {
  open
  investigating
  monitoring
  resolved
}

enum MaintenanceWindowStatus {
  scheduled
  inProgress
  completed
  cancelled
}

model School {
  importSourceProfiles            ImportSourceProfile[]
  dataQualityIssues             DataQualityIssue[]
  dataQualityRuns               DataQualityRun[]
  events                        SchoolEvent[]
  meetingAvailability           TeacherMeetingAvailability[]
  meetingRequests               ParentTeacherMeetingRequest[]
  courseworkAssignments         CourseworkAssignment[]
  gradebookLocks                GradebookLock[]
  markCorrections               MarkCorrection[]
  markModerationRequests        MarkModerationRequest[]
  markEntryWindows              MarkEntryWindow[]
  assessmentInvigilations       AssessmentInvigilation[]
  makeUpAssessments             MakeUpAssessment[]
  assessmentParticipations      AssessmentParticipation[]
  assessmentRooms               AssessmentRoom[]
  assessmentSchedules           AssessmentSchedule[]
  assessmentSessions            AssessmentSession[]
  calendarDays                  SchoolCalendarDay[]
  timetablePeriods              TimetablePeriod[]
  timetableEntries              ClassTimetableEntry[]
  timetables                    ClassTimetable[]
  attendanceSessions            AttendanceSession[]
  fileAssets                    FileAsset[]
  resultSets                    ResultSet[]
  publishedResults              PublishedResult[]
  learningMaterials             LearningMaterial[]
  announcements                 Announcement[]
  id                            String                        @id @default(uuid())
  organizationId                String
  name                          String
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  organization                  Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff                         SchoolMembership[]
  academicYears                 AcademicYear[]
  gradeLevels                   GradeLevel[]
  subjects                      Subject[]
  classes                       SchoolClass[]
  enrollments                   Enrollment[]
  teachingAssignments           TeachingAssignment[]
  gradingPeriods                GradingPeriod[]
  assessments                   Assessment[]
  marks                         Mark[]
  gradingScheme                 GradingScheme?
  issuedDocuments               IssuedDocument[]
  outgoingTransfers             TransferRequest[]             @relation("SendingTransfers")
  incomingTransfers             TransferRequest[]             @relation("ReceivingTransfers")
  verifiedGuardianRelationships StudentGuardian[]
  serviceAccess                 SchoolServiceAccess?
  familyConversations           FamilyConversation[]
  reportingRequirements         ReportingRequirement[]
  reportingSubmissions          ReportingSubmission[]
  verificationEvents            VerificationEvent[]
  importJobs                    ImportJob[]
  documentProfile               SchoolDocumentProfile?
  progressionPlans              ProgressionPlan[]
  documentRequests              DocumentRequest[]
  onboarding                    SchoolOnboarding?
  contacts                      SchoolContact[]
  trainingRecords               TrainingRecord[]
  correctionRequests            StudentCorrectionRequest[]
  enrollmentCorrectionRequests  EnrollmentCorrectionRequest[]
  privacyRequests               PrivacyRequest[]
  processingRestrictions        ProcessingRestriction[]
  supportRequests               SupportRequest[]

  @@index([organizationId])
}

model User {
  importSourceProfilesCreated     ImportSourceProfile[]        @relation("ImportSourceProfileCreator")
  importSourceProfilesUpdated     ImportSourceProfile[]        @relation("ImportSourceProfileUpdater")
  externalRecordReferences      ExternalRecordReference[]
  reportingNotesAuthored         ReportingReviewNote[]
  reportingVersionsSubmitted     ReportingSubmissionVersion[]  @relation("ReportingVersionSubmitter")
  dismissedDataQualityIssues     DataQualityIssue[]            @relation("DataQualityIssueDismisser")
  resolvedDataQualityIssues      DataQualityIssue[]            @relation("DataQualityIssueResolver")
  eventResponses                 EventResponse[]
  eventResponseHistory           EventResponseHistory[]
  eventAttachmentsCreated        EventAttachment[]
  schoolEventsCreated            SchoolEvent[]
  meetingEvents                  MeetingEvent[]
  meetingAvailability            TeacherMeetingAvailability[]
  meetingRequestsMade            ParentTeacherMeetingRequest[] @relation("MeetingGuardianUser")
  meetingRequestsAssigned        ParentTeacherMeetingRequest[] @relation("MeetingTeacher")
  courseworkMarkTransfersCreated CourseworkMarkTransfer[]      @relation("CourseworkMarkTransferCreator")
  courseworkFeedbackAuthored     CourseworkFeedback[]          @relation("CourseworkFeedbackAuthor")
  courseworkScoresCreated        RubricScore[]                 @relation("RubricScorer")
  courseworkRubricsCreated       CourseworkRubric[]            @relation("CourseworkRubricCreator")
  submissionReviewsCompleted     SubmissionReview[]            @relation("SubmissionReviewer")
  assignmentExtensionsCreated    AssignmentExtension[]         @relation("AssignmentExtensionCreator")
  courseworkAttachmentsCreated   CourseworkAttachment[]        @relation("CourseworkAttachmentCreator")
  courseworkAssignmentsCreated   CourseworkAssignment[]        @relation("CourseworkAssignmentCreator")
  gradebookLockActors            GradebookLockEvent[]
  reviewedMarkCorrections        MarkCorrection[]
  requestedMarkModerations       MarkModerationRequest[]       @relation("ModerationRequester")
  reviewedMarkModerations        MarkModerationRequest[]       @relation("ModerationReviewer")
  createdMarkEntryWindows        MarkEntryWindow[]
  assessmentInvigilations        AssessmentInvigilation[]
  assignedInvigilations          AssessmentInvigilation[]      @relation("InvigilationAssigner")
  makeUpCreated                  MakeUpAssessment[]            @relation("MakeUpCreator")
  makeUpApproved                 MakeUpAssessment[]            @relation("MakeUpApprover")
  assessmentParticipations       AssessmentParticipation[]     @relation("AssessmentParticipationRecorder")
  performedAttendanceCorrections AttendanceCorrection[]        @relation("AttendanceCorrectionPerformer")
  approvedAttendanceCorrections  AttendanceCorrection[]        @relation("AttendanceCorrectionApprover")
  openedAttendanceSessions       AttendanceSession[]
  recordedAttendance             StudentAttendanceRecord[]
  createdFileAssets              FileAsset[]                   @relation("FileAssetCreatedBy")
  ownedFileAssets                FileAsset[]                   @relation("FileAssetOwner")
  createdBackups                 BackupRecord[]                @relation("BackupCreatedBy")
  performedRestoreRehearsals     RestoreRehearsal[]            @relation("RestoreRehearsalPerformedBy")
  updatedBackupPolicies          BackupPolicy[]                @relation("BackupPolicyUpdatedBy")
  createdOperationalIncidents    OperationalIncident[]         @relation("OperationalIncidentCreatedBy")
  resolvedOperationalIncidents   OperationalIncident[]         @relation("OperationalIncidentResolvedBy")
  operationalIncidentUpdates     OperationalIncidentUpdate[]
  createdMaintenanceWindows      MaintenanceWindow[]
  submittedResultSets            ResultSet[]                   @relation("ResultSetSubmittedBy")
  issuedDocuments                IssuedDocument[]
  requestedTransfers             TransferRequest[]
  approvedTransfers              TransferRequest[]             @relation("TransferApprovedBy")
  acceptedTransfers              TransferRequest[]             @relation("TransferAcceptedBy")
  rejectedTransfers              TransferRequest[]             @relation("TransferRejectedBy")
  cancelledTransfers             TransferRequest[]             @relation("TransferCancelledBy")
  correctedDocuments             IssuedDocument[]              @relation("DocumentCorrectedBy")
  withdrawnDocuments             IssuedDocument[]              @relation("DocumentWithdrawnBy")
  publishedResultSets            ResultSet[]                   @relation("ResultSetPublishedBy")
  resultCorrections              ResultCorrection[]
  learningMaterials              LearningMaterial[]
  announcements                  Announcement[]
  id                             String                        @id @default(uuid())
  email                          String                        @unique
  displayName                    String
  preferredLocale                PreferredLocale               @default(en)
  preferredCalendar              CalendarPreference            @default(gregorian)
  accountStatus                  AccountStatus                 @default(active)
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  organizationMemberships        OrganizationMembership[]
  schoolMemberships              SchoolMembership[]
  bureauAccesses                 BureauAccess[]
  passwordCredential             PasswordCredential?
  studentAccess                  StudentAccess?
  guardianVerifications          StudentGuardian[]             @relation("GuardianVerifiedBy")
  guardianRevocations            StudentGuardian[]             @relation("GuardianRevokedBy")
  schoolServiceUpdates           SchoolServiceAccess[]
  familyMessages                 FamilyMessage[]
  teacherConversations           FamilyConversation[]          @relation("FamilyConversationTeacher")
  closedFamilyConversations      FamilyConversation[]          @relation("FamilyConversationClosedBy")
  escalatedFamilyConversations   FamilyConversation[]          @relation("FamilyConversationEscalatedBy")
  guardianAccess                 GuardianAccess?
  recoveryRequests               AccountRecoveryRequest[]
  emailDeliveries                EmailDelivery[]
  notificationPreferences        NotificationPreference[]
  emailDigests                   EmailDigest[]
  resolvedRecoveryReviews        RecoveryReview[]              @relation("RecoveryReviewResolver")
  startedOnboardings             SchoolOnboarding[]            @relation("OnboardingStartedBy")
  completedOnboardings           SchoolOnboarding[]            @relation("OnboardingCompletedBy")
  completedChecklistItems        OnboardingChecklistItem[]
  trainingRecords                TrainingRecord[]              @relation("TrainingUser")
  recordedTraining               TrainingRecord[]              @relation("TrainingRecordedBy")
  createdSupportRequests         SupportRequest[]              @relation("SupportRequestCreatedBy")
  assignedSupportRequests        SupportRequest[]              @relation("SupportRequestAssignedTo")
  supportRequestMessages         SupportRequestMessage[]
  sessions                       Session[]
  supportIdentity                SupportIdentity?
  approvedEnrollments            Enrollment[]                  @relation("EnrollmentApprovedBy")
  withdrawnEnrollments           Enrollment[]                  @relation("EnrollmentWithdrawnBy")
  createdImportJobs              ImportJob[]
  requestedDocuments             DocumentRequest[]
  performedEnrollmentEvents      EnrollmentHistoryEvent[]
  closedAcademicYears            AcademicYear[]                @relation("AcademicYearClosedBy")
  createdProgressionPlans        ProgressionPlan[]             @relation("ProgressionPlanCreatedBy")
  reviewedProgressionPlans       ProgressionPlan[]             @relation("ProgressionPlanReviewedBy")
  appliedProgressionPlans        ProgressionPlan[]             @relation("ProgressionPlanAppliedBy")
  resolvedProgressionExceptions  ProgressionException[]        @relation("ProgressionExceptionResolvedBy")
  notifications                  Notification[]
  teachingAssignments            TeachingAssignment[]
  requestedStudentCorrections    StudentCorrectionRequest[]    @relation("StudentCorrectionRequestedBy")
  reviewedStudentCorrections     StudentCorrectionRequest[]    @relation("StudentCorrectionReviewedBy")
  requestedEnrollmentCorrections EnrollmentCorrectionRequest[] @relation("EnrollmentCorrectionRequestedBy")
  reviewedEnrollmentCorrections  EnrollmentCorrectionRequest[] @relation("EnrollmentCorrectionReviewedBy")
  privacyRequests                PrivacyRequest[]              @relation("PrivacyRequestRequester")
  reviewedPrivacyRequests        PrivacyRequest[]              @relation("PrivacyRequestReviewer")
  approvedRestrictions           ProcessingRestriction[]       @relation("RestrictionApprovedBy")
  endedRestrictions              ProcessingRestriction[]       @relation("RestrictionEndedBy")
  createdRetentionHolds          RetentionHold[]               @relation("RetentionHoldCreatedBy")
  releasedRetentionHolds         RetentionHold[]               @relation("RetentionHoldReleasedBy")
  marks                          Mark[]
}

enum ExternalEntityType {
  student
  school
  staff
}

model ExternalRecordReference {
  id          String             @id @default(uuid())
  sourceSystem String
  externalId  String
  entityType  ExternalEntityType
  entityId    String
  createdAt   DateTime           @default(now())
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([sourceSystem, entityType, externalId])
  @@index([entityType, entityId])
  @@index([createdById, createdAt])
}

enum ImportSourceFormat {
  csv
  xlsx
}

model ImportSourceProfile {
  id             String             @id @default(uuid())
  name           String
  schoolId       String?
  organizationId String?
  format         ImportSourceFormat
  entityType     ExternalEntityType
  mapping        Json
  createdById    String
  updatedById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  school         School?            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("ImportSourceProfileCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User               @relation("ImportSourceProfileUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([schoolId, entityType])
  @@index([organizationId, entityType])
}

model FileAsset {
  eventAttachment      EventAttachment?
  courseworkAttachment CourseworkAttachment?
  submissionAttachment SubmissionAttachment?
  id                   String                 @id @default(uuid())
  schoolId             String?
  ownerUserId          String?
  purpose              FileAssetPurpose
  originalFileName     String
  contentType          String
  sizeBytes            BigInt
  checksum             String
  storageKey           String                 @unique
  status               FileAssetStatus        @default(pending)
  scanRequired         Boolean                @default(false)
  createdAt            DateTime               @default(now())
  createdById          String
  deletedAt            DateTime?
  learningMaterialId   String?                @unique
  issuedDocumentId     String?                @unique
  school               School?                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  ownerUser            User?                  @relation("FileAssetOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy            User                   @relation("FileAssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  learningMaterial     LearningMaterial?      @relation(fields: [learningMaterialId], references: [id], onDelete: Restrict)
  issuedDocument       IssuedDocument?        @relation(fields: [issuedDocumentId], references: [id], onDelete: Restrict)
  activeLogoFor        SchoolDocumentProfile? @relation("ActiveSchoolLogo")
  scans                FileScan[]

  @@index([schoolId, purpose, status])
  @@index([ownerUserId, purpose, status])
  @@index([createdAt])
}

model FileScan {
  id          String          @id @default(uuid())
  fileAssetId String
  scanner     String
  status      FileScanStatus  @default(pending)
  startedAt   DateTime?
  completedAt DateTime?
  result      FileScanResult?
  failureCode String?
  createdAt   DateTime        @default(now())
  fileAsset   FileAsset       @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([fileAssetId, createdAt])
  @@index([status, createdAt])
}

model MaintenanceWindow {
  id          String                  @id @default(uuid())
  title       String
  reason      String
  startsAt    DateTime
  endsAt      DateTime
  status      MaintenanceWindowStatus @default(scheduled)
  createdById String
  createdAt   DateTime                @default(now())
  createdBy   User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, startsAt])
}

model OperationalIncident {
  id           String                      @id @default(uuid())
  severity     OperationalIncidentSeverity
  title        String
  summary      String
  status       OperationalIncidentStatus   @default(open)
  startedAt    DateTime                    @default(now())
  resolvedAt   DateTime?
  createdById  String
  resolvedById String?
  createdBy    User                        @relation("OperationalIncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy   User?                       @relation("OperationalIncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  updates      OperationalIncidentUpdate[]

  @@index([status, startedAt])
  @@index([severity, startedAt])
}

model OperationalIncidentUpdate {
  id          String                    @id @default(uuid())
  incidentId  String
  status      OperationalIncidentStatus
  message     String
  createdById String
  createdAt   DateTime                  @default(now())
  incident    OperationalIncident       @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  createdBy   User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
}

model BackupPolicy {
  id                   String          @id @default("database")
  enabled              Boolean         @default(false)
  frequency            BackupFrequency @default(daily)
  retentionCount       Int             @default(7)
  verificationRequired Boolean         @default(true)
  updatedById          String
  updatedAt            DateTime        @updatedAt
  updatedBy            User            @relation("BackupPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
}

model ScheduledTaskExecution {
  id                  String                   @id @default(uuid())
  seriesId            String                   @default(uuid())
  taskType            ScheduledTaskType
  scope               String
  resourceId          String?
  scheduledFor        DateTime
  startedAt           DateTime?
  completedAt         DateTime?
  interruptedAt       DateTime?
  status              ScheduledTaskStatus      @default(pending)
  recoveryDisposition TaskRecoveryDisposition?
  recoveryReason      String?
  claimedAt           DateTime?
  leaseExpiresAt      DateTime?
  heartbeatAt         DateTime?
  workerId            String?
  attempt             Int                      @default(1)
  failureCode         String?
  eligibleCount       Int?
  oldestEligibleAt    DateTime?
  createdAt           DateTime                 @default(now())

  @@unique([seriesId, attempt])
  @@index([taskType, scope, scheduledFor])
  @@index([status, createdAt])
  @@index([status, startedAt])
  @@index([status, leaseExpiresAt])
  @@index([taskType, status, scheduledFor])
}

model RecoveryReview {
  id                String               @id @default(uuid())
  domain            RecoveryDomain
  resourceType      String
  resourceReference String
  reasonCode        String
  status            RecoveryReviewStatus @default(open)
  createdAt         DateTime             @default(now())
  resolvedAt        DateTime?
  resolvedById      String?
  resolution        String?
  resolvedBy        User?                @relation("RecoveryReviewResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([domain, resourceReference])
}

model BackupRecord {
  id                 String                    @id @default(uuid())
  scope              BackupScope               @default(database)
  status             BackupStatus              @default(pending)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                  @default(now())
  createdById        String
  sizeBytes          BigInt?
  checksum           String?
  storageReference   String?
  failureReason      String?
  verifiedAt         DateTime?
  verificationResult BackupVerificationResult?
  verificationReason String?
  deletedAt          DateTime?
  createdBy          User                      @relation("BackupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rehearsals         RestoreRehearsal[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model RestoreRehearsal {
  id            String                 @id @default(uuid())
  backupId      String
  startedAt     DateTime               @default(now())
  completedAt   DateTime?
  status        RestoreRehearsalStatus @default(running)
  failureReason String?
  performedById String
  backup        BackupRecord           @relation(fields: [backupId], references: [id], onDelete: Restrict)
  performedBy   User                   @relation("RestoreRehearsalPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([backupId, startedAt])
  @@index([status, startedAt])
}

model OrganizationMembership {
  userId         String
  organizationId String
  role           OrganizationRole
  startsAt       DateTime         @default(now())
  endsAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model SchoolMembership {
  userId    String
  schoolId  String
  role      SchoolRole
  startsAt  DateTime   @default(now())
  endsAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

