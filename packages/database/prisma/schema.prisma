  reason          String?                     @db.VarChar(300)
  previousStartAt DateTime?
  previousEndAt   DateTime?
  newStartAt      DateTime?
  newEndAt        DateTime?
  createdAt       DateTime                    @default(now())
  request         ParentTeacherMeetingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor           User                        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model ClassTimetable {
  id             String                @id @default(uuid())
  schoolId       String
  academicYearId String
  schoolClassId  String
  status         TimetableStatus       @default(draft)
  createdAt      DateTime              @default(now())
  publishedAt    DateTime?
  archivedAt     DateTime?
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear          @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass    SchoolClass           @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  entries        ClassTimetableEntry[]

  @@unique([id, schoolId, academicYearId, schoolClassId], map: "ClassTimetable_scope_key")
  @@index([schoolId, academicYearId, schoolClassId, status])
}

model ClassTimetableEntry {
  id                   String             @id @default(uuid())
  timetableId          String
  schoolId             String
  academicYearId       String
  schoolClassId        String
  subjectId            String
  teachingAssignmentId String
  timetablePeriodId    String
  weekday              Int
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  school               School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  timetable            ClassTimetable     @relation(fields: [timetableId, schoolId, academicYearId, schoolClassId], references: [id, schoolId, academicYearId, schoolClassId], onDelete: Restrict, map: "ClassTimetableEntry_timetable_scope_fkey")
  academicYear         AcademicYear       @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass          SchoolClass        @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject              Subject            @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId, schoolId, academicYearId, schoolClassId, subjectId], references: [id, schoolId, academicYearId, schoolClassId, subjectId], onDelete: Restrict, map: "ClassTimetableEntry_assignment_scope_fkey")
  timetablePeriod      TimetablePeriod    @relation(fields: [timetablePeriodId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([timetableId, weekday, timetablePeriodId], map: "ClassTimetableEntry_plan_slot_key")
  @@index([schoolId, academicYearId, weekday])
  @@index([teachingAssignmentId, weekday])
}

model AttendanceSession {
  id                   String                    @id @default(uuid())
  schoolId             String
  academicYearId       String
  schoolClassId        String
  date                 DateTime                  @db.Date
  timetablePeriodId    String?
  subjectId            String?
  teachingAssignmentId String?
  status               AttendanceSessionStatus   @default(open)
  createdById          String
  createdAt            DateTime                  @default(now())
  submittedAt          DateTime?
  finalizedAt          DateTime?
  cancelledAt          DateTime?
  school               School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear         AcademicYear              @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass          SchoolClass               @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  timetablePeriod      TimetablePeriod?          @relation(fields: [timetablePeriodId, schoolId], references: [id, schoolId], onDelete: Restrict)
  subject              Subject?                  @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  teachingAssignment   TeachingAssignment?       @relation(fields: [teachingAssignmentId, schoolId, academicYearId, schoolClassId, subjectId], references: [id, schoolId, academicYearId, schoolClassId, subjectId], onDelete: Restrict, map: "AttendanceSession_assignment_scope_fkey")
  createdBy            User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  records              StudentAttendanceRecord[]

  @@unique([id, schoolId, academicYearId, schoolClassId], map: "AttendanceSession_record_scope_key")
  @@index([schoolId, academicYearId, schoolClassId, date])
  @@index([teachingAssignmentId, date])
}

model StudentAttendanceRecord {
  id             String                  @id @default(uuid())
  sessionId      String
  schoolId       String
  academicYearId String
  schoolClassId  String
  studentId      String
  enrollmentId   String
  status         StudentAttendanceStatus
  note           String?
  recordedById   String
  recordedAt     DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  session        AttendanceSession       @relation(fields: [sessionId, schoolId, academicYearId, schoolClassId], references: [id, schoolId, academicYearId, schoolClassId], onDelete: Restrict, map: "StudentAttendanceRecord_session_scope_fkey")
  student        Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment     Enrollment              @relation(fields: [enrollmentId, schoolId, academicYearId, schoolClassId, studentId], references: [id, schoolId, academicYearId, schoolClassId, studentId], onDelete: Restrict, map: "StudentAttendanceRecord_enrollment_scope_fkey")
  recordedBy     User                    @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  corrections    AttendanceCorrection[]

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId, recordedAt])
}

model AttendanceCorrection {
  id             String                  @id @default(uuid())
  recordId       String
  previousStatus StudentAttendanceStatus
  newStatus      StudentAttendanceStatus
  reason         String
  performedById  String
  approvedById   String?
  effectiveAt    DateTime                @default(now())
  record         StudentAttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  performedBy    User                    @relation("AttendanceCorrectionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  approvedBy     User?                   @relation("AttendanceCorrectionApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([recordId, effectiveAt])
}

model GradingPeriod {
  courseworkAssignments CourseworkAssignment[]
  gradebookLocks        GradebookLock[]
  assessmentSchedules   AssessmentSchedule[]
  resultSets            ResultSet[]
  id                    String                 @id @default(uuid())
  schoolId              String
  academicYearId        String
  name                  String
  startsOn              DateTime               @db.Date
  endsOn                DateTime               @db.Date
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear           @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  assessments           Assessment[]

  @@unique([schoolId, academicYearId, name])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, startsOn])
}

model Assessment {
  courseworkAssignments CourseworkAssignment[]
  markEntryWindow       MarkEntryWindow?
  schedules             AssessmentSchedule[]
  id                    String                 @id @default(uuid())
  schoolId              String
  academicYearId        String
  gradingPeriodId       String
  schoolClassId         String
  subjectId             String
  name                  String
  maximumScore          Decimal                @db.Decimal(8, 2)
  weight                Decimal                @db.Decimal(5, 2)
  position              Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear           @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod         GradingPeriod          @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass           SchoolClass            @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject               Subject                @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  marks                 Mark[]

  @@unique([id, schoolId])
  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, name], map: "Assessment_context_name_key")
  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, position], map: "Assessment_context_position_key")
  @@index([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId])
}

model CourseworkAssignment {
  markTransfers        CourseworkMarkTransfer[]
  rubric               CourseworkRubric?
  extensions           AssignmentExtension[]
  attachments          CourseworkAttachment[]
  submissions          CourseworkSubmission[]
  id                   String                     @id @default(uuid())
  schoolId             String
  academicYearId       String
  gradingPeriodId      String?
  schoolClassId        String
  subjectId            String
  teachingAssignmentId String
  assessmentId         String?
  createdById          String
  title                String                     @db.VarChar(200)
  instructions         String                     @db.Text
  assignedAt           DateTime?
  dueAt                DateTime
  status               CourseworkAssignmentStatus @default(draft)
  publishedAt          DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  school               School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear         AcademicYear               @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod        GradingPeriod?             @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass          SchoolClass                @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject              Subject                    @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  teachingAssignment   TeachingAssignment         @relation(fields: [teachingAssignmentId, schoolId, academicYearId, schoolClassId, subjectId], references: [id, schoolId, academicYearId, schoolClassId, subjectId], onDelete: Restrict)
  assessment           Assessment?                @relation(fields: [assessmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy            User                       @relation("CourseworkAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, academicYearId, schoolClassId, subjectId, status])
  @@index([schoolId, createdAt, id])
  @@index([teachingAssignmentId, status])
}

model CourseworkRubric {
  scores       RubricScore[]
  id           String               @id @default(uuid())
  schoolId     String
  assignmentId String
  title        String               @db.VarChar(200)
  createdById  String
  frozenAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assignment   CourseworkAssignment @relation(fields: [assignmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy    User                 @relation("CourseworkRubricCreator", fields: [createdById], references: [id], onDelete: Restrict)
  criteria     RubricCriterion[]

  @@unique([assignmentId, schoolId])
  @@index([schoolId, createdAt])
}

model RubricCriterion {
  scores      RubricCriterionScore[]
  id          String                 @id @default(uuid())
  rubricId    String
  title       String                 @db.VarChar(200)
  description String                 @db.VarChar(1000)
  maxPoints   Decimal                @db.Decimal(7, 2)
  sortOrder   Int
  rubric      CourseworkRubric       @relation(fields: [rubricId], references: [id], onDelete: Restrict)

  @@unique([rubricId, sortOrder])
}

model RubricScore {
  markTransfers CourseworkMarkTransfer[]
  id            String                   @id @default(uuid())
  revisionId    String
  rubricId      String
  version       Int
  totalPoints   Decimal                  @db.Decimal(9, 2)
  scoredById    String
  createdAt     DateTime                 @default(now())
  revision      SubmissionRevision       @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  rubric        CourseworkRubric         @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  scoredBy      User                     @relation("RubricScorer", fields: [scoredById], references: [id], onDelete: Restrict)
  criteria      RubricCriterionScore[]

  @@unique([revisionId, version])
  @@index([rubricId, createdAt])
}

model RubricCriterionScore {
  id          String          @id @default(uuid())
  scoreId     String
  criterionId String
  points      Decimal         @db.Decimal(7, 2)
  score       RubricScore     @relation(fields: [scoreId], references: [id], onDelete: Restrict)
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([scoreId, criterionId])
}

model CourseworkMarkTransfer {
  id               String               @id @default(uuid())
  schoolId         String
  assignmentId     String
  revisionId       String
  rubricScoreId    String
  markId           String               @unique
  scoreTransferred Decimal              @db.Decimal(9, 2)
  createdById      String
  createdAt        DateTime             @default(now())
  assignment       CourseworkAssignment @relation(fields: [assignmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  revision         SubmissionRevision   @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  rubricScore      RubricScore          @relation(fields: [rubricScoreId], references: [id], onDelete: Restrict)
  mark             Mark                 @relation(fields: [markId], references: [id], onDelete: Restrict)
  createdBy        User                 @relation("CourseworkMarkTransferCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, assignmentId, createdAt])
  @@index([revisionId, createdAt])
}

model AssignmentExtension {
  id            String               @id @default(uuid())
  schoolId      String
  assignmentId  String
  studentId     String
  enrollmentId  String
  originalDueAt DateTime
  extendedDueAt DateTime
  reason        String               @db.VarChar(500)
  createdById   String
  createdAt     DateTime             @default(now())
  assignment    CourseworkAssignment @relation(fields: [assignmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment    Enrollment           @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  createdBy     User                 @relation("AssignmentExtensionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assignmentId, studentId, createdAt])
  @@index([schoolId, createdAt])
}

model CourseworkSubmission {
  revisions    SubmissionRevision[]
  id           String                     @id @default(uuid())
  schoolId     String
  assignmentId String
  studentId    String
  enrollmentId String
  status       CourseworkSubmissionStatus @default(draft)
  startedAt    DateTime                   @default(now())
  submittedAt  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  assignment   CourseworkAssignment       @relation(fields: [assignmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  student      Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment   Enrollment                 @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([schoolId, assignmentId, status])
  @@index([studentId, status])
}

model SubmissionRevision {
  markTransfers  CourseworkMarkTransfer[]
  feedback       CourseworkFeedback?
  rubricScores   RubricScore[]
  review         SubmissionReview?
  attachments    SubmissionAttachment[]
  id             String                   @id @default(uuid())
  submissionId   String
  revisionNumber Int
  textResponse   String                   @db.Text
  submittedAt    DateTime?
  createdAt      DateTime                 @default(now())
  submission     CourseworkSubmission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([submissionId, revisionNumber])
  @@index([submissionId, submittedAt])
}

model CourseworkFeedback {
  id         String                   @id @default(uuid())
  revisionId String                   @unique
  text       String                   @db.Text
  status     CourseworkFeedbackStatus @default(draft)
  authorId   String
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  releasedAt DateTime?
  revision   SubmissionRevision       @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  author     User                     @relation("CourseworkFeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, releasedAt])
}

model SubmissionReview {
  id                  String                 @id @default(uuid())
  revisionId          String                 @unique
  status              SubmissionReviewStatus @default(pending)
  reviewedById        String?
  reviewedAt          DateTime?
  resubmissionAllowed Boolean                @default(false)
  resubmissionDueAt   DateTime?
  createdAt           DateTime               @default(now())
  revision            SubmissionRevision     @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  reviewedBy          User?                  @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model SubmissionAttachment {
  id          String             @id @default(uuid())
  schoolId    String
  revisionId  String
  fileAssetId String             @unique
  createdAt   DateTime           @default(now())
  removedAt   DateTime?
  revision    SubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  fileAsset   FileAsset          @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([revisionId, removedAt])
  @@index([schoolId, createdAt])
}

model CourseworkAttachment {
  id           String               @id @default(uuid())
  schoolId     String
  assignmentId String
  fileAssetId  String               @unique
  createdById  String
  createdAt    DateTime             @default(now())
  removedAt    DateTime?
  assignment   CourseworkAssignment @relation(fields: [assignmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  fileAsset    FileAsset            @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("CourseworkAttachmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assignmentId, removedAt])
  @@index([schoolId, createdAt])
}

model MarkEntryWindow {
  id              String                @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  assessmentId    String                @unique
  opensAt         DateTime
  closesAt        DateTime
  status          MarkEntryWindowStatus @default(scheduled)
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  school          School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assessment      Assessment            @relation(fields: [assessmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy       User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([assessmentId, schoolId])
  @@index([schoolId, academicYearId, gradingPeriodId])
}

model AssessmentRoom {
  schedules AssessmentSchedule[]
  id        String               @id @default(uuid())
  schoolId  String
  name      String
  code      String
  capacity  Int?
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([id, schoolId])
  @@index([schoolId, active])
}

model AssessmentSchedule {
  sessions        AssessmentSession[]
  id              String                   @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  assessmentId    String
  roomId          String?
  scheduledDate   DateTime                 @db.Date
  startTime       String                   @db.VarChar(5)
  endTime         String                   @db.VarChar(5)
  status          AssessmentScheduleStatus @default(draft)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  school          School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear             @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod            @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass              @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject                  @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  assessment      Assessment               @relation(fields: [assessmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  room            AssessmentRoom?          @relation(fields: [roomId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, scheduledDate, startTime])
  @@index([assessmentId, status])
}

model AssessmentSession {
  invigilations     AssessmentInvigilation[]
  participations    AssessmentParticipation[]
  makeUpAssessments MakeUpAssessment[]
  id                String                    @id @default(uuid())
  schoolId          String
  scheduleId        String
  schoolClassId     String
  sessionDate       DateTime                  @db.Date
  startTime         String                    @db.VarChar(5)
  endTime           String                    @db.VarChar(5)
  status            AssessmentSessionStatus   @default(planned)
  openedAt          DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schedule          AssessmentSchedule        @relation(fields: [scheduleId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass       SchoolClass               @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([id, schoolId])
  @@unique([scheduleId])
  @@index([schoolId, schoolClassId, sessionDate])
}

model AssessmentInvigilation {
  id           String            @id @default(uuid())
  schoolId     String
  sessionId    String
  userId       String
  assignedById String
  createdAt    DateTime          @default(now())
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  session      AssessmentSession @relation(fields: [sessionId, schoolId], references: [id, schoolId], onDelete: Restrict)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User              @relation("InvigilationAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, userId])
  @@index([schoolId, userId])
}

model AssessmentParticipation {
  makeUpAssessments MakeUpAssessment[]
  id                String                        @id @default(uuid())
  schoolId          String
  sessionId         String
  studentId         String
  enrollmentId      String
  academicYearId    String
  schoolClassId     String
  status            AssessmentParticipationStatus
  recordedById      String
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  school            School                        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  session           AssessmentSession             @relation(fields: [sessionId, schoolId], references: [id, schoolId], onDelete: Restrict)
  student           Student                       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment        Enrollment                    @relation(fields: [enrollmentId, schoolId, academicYearId, schoolClassId, studentId], references: [id, schoolId, academicYearId, schoolClassId, studentId], onDelete: Restrict)
  recordedBy        User                          @relation("AssessmentParticipationRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId])
}

model MakeUpAssessment {
  id                      String                  @id @default(uuid())
  schoolId                String
  originalSessionId       String
  originalParticipationId String
  studentId               String
  reason                  String
  status                  MakeUpAssessmentStatus  @default(requested)
  scheduledDate           DateTime?               @db.Date
  startTime               String?                 @db.VarChar(5)
  endTime                 String?                 @db.VarChar(5)
  createdById             String
  approvedById            String?
  reviewedAt              DateTime?
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  school                  School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  originalSession         AssessmentSession       @relation(fields: [originalSessionId, schoolId], references: [id, schoolId], onDelete: Restrict)
  originalParticipation   AssessmentParticipation @relation(fields: [originalParticipationId], references: [id], onDelete: Restrict)
  student                 Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdBy               User                    @relation("MakeUpCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy              User?                   @relation("MakeUpApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([originalParticipationId])
  @@index([schoolId, status])
}

model Mark {
  courseworkTransfer CourseworkMarkTransfer?
  moderationRequests MarkModerationRequest[]
  corrections        MarkCorrection[]
  id                 String                  @id @default(uuid())
  schoolId           String
  studentId          String
  enrollmentId       String
  assessmentId       String
  score              Decimal                 @db.Decimal(8, 2)
  recordedById       String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment         Enrollment              @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  assessment         Assessment              @relation(fields: [assessmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  recordedBy         User                    @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, assessmentId])
  @@index([schoolId, assessmentId])
  @@index([schoolId, studentId])
}

model MarkModerationRequest {
  correction    MarkCorrection?
  id            String               @id @default(uuid())
  schoolId      String
  markId        String
  originalScore Decimal              @db.Decimal(8, 2)
  proposedScore Decimal              @db.Decimal(8, 2)
  reason        String
  status        MarkModerationStatus @default(pending)
  requestedById String
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  mark          Mark                 @relation(fields: [markId], references: [id], onDelete: Restrict)
  requestedBy   User                 @relation("ModerationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?                @relation("ModerationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([markId, createdAt])
}

model MarkCorrection {
  id                  String                @id @default(uuid())
  schoolId            String
  markId              String
  moderationRequestId String                @unique
  previousScore       Decimal               @db.Decimal(8, 2)
  newScore            Decimal               @db.Decimal(8, 2)
  reviewerId          String
  reason              String
  effectiveAt         DateTime              @default(now())
  school              School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  mark                Mark                  @relation(fields: [markId], references: [id], onDelete: Restrict)
  moderationRequest   MarkModerationRequest @relation(fields: [moderationRequestId], references: [id], onDelete: Restrict)
  reviewer            User                  @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([schoolId, markId, effectiveAt])
}

model GradebookLock {
  id              String               @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  locked          Boolean              @default(false)
  lockedAt        DateTime?
  updatedAt       DateTime             @updatedAt
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear         @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod        @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass          @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject              @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  events          GradebookLockEvent[]

  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId], name: "GradebookLock_context_key", map: "GradebookLock_context_key")
  @@index([schoolId, locked])
}

model GradebookLockEvent {
  id          String              @id @default(uuid())
  lockId      String
  action      GradebookLockAction
  actorId     String
  reason      String?
  effectiveAt DateTime            @default(now())
  lock        GradebookLock       @relation(fields: [lockId], references: [id], onDelete: Restrict)
  actor       User                @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([lockId, effectiveAt])
}

model GradingScheme {
  id        String      @id @default(uuid())
  schoolId  String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  bands     GradeBand[]
}

model GradeBand {
  id                String        @id @default(uuid())
  gradingSchemeId   String
  label             String
  minimumPercentage Decimal       @db.Decimal(5, 2)
  gradingScheme     GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@unique([gradingSchemeId, label])
  @@unique([gradingSchemeId, minimumPercentage])
  @@index([gradingSchemeId, minimumPercentage])
}

model ResultSet {
  id              String            @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  status          ResultSetStatus   @default(draft)
  submittedAt     DateTime?
  submittedById   String?
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear      @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod     @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass       @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject           @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  submittedBy     User?             @relation("ResultSetSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  publishedBy     User?             @relation("ResultSetPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  results         PublishedResult[]

  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId], map: "ResultSet_context_key")
  @@unique([id, schoolId])
  @@index([schoolId, status])
}

model PublishedResult {
  id                String             @id @default(uuid())
  schoolId          String
  resultSetId       String
  studentId         String
  enrollmentId      String
  percentage        Decimal            @db.Decimal(5, 2)
  gradeLabel        String
  currentPercentage Decimal            @db.Decimal(5, 2)
  currentGradeLabel String
  createdAt         DateTime           @default(now())
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  resultSet         ResultSet          @relation(fields: [resultSetId, schoolId], references: [id, schoolId], onDelete: Restrict)
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment        Enrollment         @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  corrections       ResultCorrection[]

  @@unique([resultSetId, enrollmentId])
  @@unique([id, schoolId])
  @@index([schoolId, studentId])
}

model ResultCorrection {
  id                 String          @id @default(uuid())
  schoolId           String
  publishedResultId  String
  previousPercentage Decimal         @db.Decimal(5, 2)
  previousGradeLabel String
  newPercentage      Decimal         @db.Decimal(5, 2)
  newGradeLabel      String
  reason             String
  actorId            String
  effectiveAt        DateTime        @default(now())
  publishedResult    PublishedResult @relation(fields: [publishedResultId, schoolId], references: [id, schoolId], onDelete: Restrict)
  actor              User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([schoolId, publishedResultId, effectiveAt])
}

model IssuedDocument {
  fileAsset             FileAsset?
  id                    String              @id @default(uuid())
  studentId             String
  schoolId              String
  academicYearId        String
  documentType          DocumentType
  snapshot              Json                @default("{}")
  supersedesId          String?             @unique
  correctionReason      String?
  correctedById         String?
  correctedAt           DateTime?
  withdrawalReason      String?
  withdrawnById         String?
  withdrawnAt           DateTime?
  verificationReference String              @unique
  status                DocumentStatus      @default(active)
  issuedAt              DateTime            @default(now())
  issuedById            String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  student               Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear        @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  issuedBy              User                @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  correctedBy           User?               @relation("DocumentCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)
  withdrawnBy           User?               @relation("DocumentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  supersedes            IssuedDocument?     @relation("DocumentVersion", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacedBy            IssuedDocument?     @relation("DocumentVersion")
  retentionHolds        RetentionHold[]
  verificationEvents    VerificationEvent[]
  documentRequest       DocumentRequest?

  @@index([schoolId, studentId, issuedAt])
  @@index([schoolId, issuedAt])
}

model VerificationEvent {
  id               String                   @id @default(uuid())
  issuedDocumentId String?
  schoolId         String?
  resultStatus     VerificationResultStatus
  occurredAt       DateTime                 @default(now())
  issuedDocument   IssuedDocument?          @relation(fields: [issuedDocumentId], references: [id], onDelete: SetNull)
  school           School?                  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, occurredAt, resultStatus])
}

model TransferRequest {
  id                    String         @id @default(uuid())
  studentId             String
  sendingSchoolId       String
  receivingSchoolId     String
  sourceEnrollmentId    String
  status                TransferStatus @default(requested)
  transferPackage       Json
  requestedById         String
  requestedAt           DateTime       @default(now())
  sendingApprovedById   String?
  sendingApprovedAt     DateTime?
  acceptedById          String?
  acceptedAt            DateTime?
  rejectedById          String?
  rejectedAt            DateTime?
  rejectionReason       String?
  cancelledById         String?
  cancelledAt           DateTime?
  cancellationReason    String?
  completedAt           DateTime?
  receivingEnrollmentId String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  student               Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sendingSchool         School         @relation("SendingTransfers", fields: [sendingSchoolId], references: [id], onDelete: Restrict)
  receivingSchool       School         @relation("ReceivingTransfers", fields: [receivingSchoolId], references: [id], onDelete: Restrict)
  sourceEnrollment      Enrollment     @relation("TransferSource", fields: [sourceEnrollmentId, sendingSchoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  requestedBy           User           @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  sendingApprovedBy     User?          @relation("TransferApprovedBy", fields: [sendingApprovedById], references: [id], onDelete: Restrict)
  acceptedBy            User?          @relation("TransferAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  rejectedBy            User?          @relation("TransferRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  cancelledBy           User?          @relation("TransferCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  receivingEnrollment   Enrollment?    @relation("TransferDestination", fields: [receivingEnrollmentId, receivingSchoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)

  @@unique([receivingEnrollmentId, receivingSchoolId, studentId])
  @@index([sendingSchoolId, status, requestedAt])
  @@index([receivingSchoolId, status, requestedAt])
  @@index([studentId, requestedAt])
}

model SchoolServiceAccess {
  id                  String    @id @default(uuid())
  schoolId            String    @unique
  parentPortalEnabled Boolean   @default(false)
  enabledAt           DateTime?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  updatedBy           User?     @relation(fields: [updatedById], references: [id], onDelete: Restrict)
}

model FamilyConversation {
  id            String                   @id @default(uuid())
  schoolId      String
  studentId     String
  guardianId    String
  route         FamilyConversationRoute
  teacherUserId String?
  status        FamilyConversationStatus @default(open)
  closedAt      DateTime?
  closedById    String?
  escalatedAt   DateTime?
  escalatedById String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student       Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian      Guardian                 @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  teacher       User?                    @relation("FamilyConversationTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  closedBy      User?                    @relation("FamilyConversationClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  escalatedBy   User?                    @relation("FamilyConversationEscalatedBy", fields: [escalatedById], references: [id], onDelete: Restrict)
  messages      FamilyMessage[]

  @@index([guardianId, createdAt])
  @@index([schoolId, route, status, createdAt])
  @@index([teacherUserId, status, createdAt])
}

model FamilyMessage {
  id             String             @id @default(uuid())
  conversationId String
  senderUserId   String
  senderKind     FamilySenderKind   @default(guardian)
  body           String
  createdAt      DateTime           @default(now())
  readAt         DateTime?
  conversation   FamilyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
}

enum ImportJobType {
  studentRegistration
}

enum ImportJobStatus {
  uploaded
  validated
  invalid
  applied
  cancelled
}

enum ImportIssueSeverity {
  error
  warning
}

model ImportJob {
  id               String           @id @default(uuid())
  schoolId         String
  createdById      String
  type             ImportJobType    @default(studentRegistration)
  status           ImportJobStatus  @default(uploaded)
  originalFileName String?
  totalRows        Int              @default(0)
  validRows        Int              @default(0)
  invalidRows      Int              @default(0)
  normalizedRows   Json             @default("[]")
  createdAt        DateTime         @default(now())
  validatedAt      DateTime?
  appliedAt        DateTime?
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy        User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  issues           ImportRowIssue[]

  @@index([schoolId, createdAt])
}

model ImportRowIssue {
  id        String              @id @default(uuid())
  jobId     String
  rowNumber Int
  severity  ImportIssueSeverity
  code      String
  message   String
  job       ImportJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber])
}

model Notification {
  id            String         @id @default(uuid())
  userId        String
  type          String
  title         String
  message       String
  resourceType  String?
  resourceId    String?
  dedupeKey     String?        @unique
  createdAt     DateTime       @default(now())
  readAt        DateTime?
  emailRoutedAt DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDelivery EmailDelivery?

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
  @@index([emailRoutedAt, createdAt])
}

model NotificationPreference {
  id            String               @id @default(uuid())
  userId        String
  category      NotificationCategory
  inAppEnabled  Boolean              @default(true)
  emailEnabled  Boolean              @default(false)
  digestCadence DigestCadence        @default(off)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model EmailDigest {
  id            String            @id @default(uuid())
  userId        String
  windowStartAt DateTime
  windowEndAt   DateTime
  status        EmailDigestStatus @default(queued)
  itemCount     Int
  createdAt     DateTime          @default(now())
  sentAt        DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivery      EmailDelivery?

  @@unique([userId, windowStartAt, windowEndAt])
  @@index([status, createdAt])
}

model SchoolDocumentProfile {
  schoolId       String     @id
  officialName   String?
  addressLine    String?
  city           String?
  region         String?
  phone          String?
  email          String?
  website        String?
  documentFooter String?
  logoAssetId    String?    @unique
  updatedAt      DateTime   @updatedAt
  school         School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  logoAsset      FileAsset? @relation("ActiveSchoolLogo", fields: [logoAssetId], references: [id], onDelete: Restrict)
}

model DocumentRequest {
  id               String                @id @default(uuid())
  studentId        String
  schoolId         String
  academicYearId   String
  documentType     DocumentType
  status           DocumentRequestStatus @default(requested)
  requestedById    String
  requestedAt      DateTime              @default(now())
  processingAt     DateTime?
  readyAt          DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  cancelledAt      DateTime?
  issuedDocumentId String?               @unique
  student          Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear          @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  requestedBy      User                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  issuedDocument   IssuedDocument?       @relation(fields: [issuedDocumentId], references: [id], onDelete: Restrict)

  @@index([studentId, requestedAt])
  @@index([schoolId, status, requestedAt])
}

model ProgressionPlan {
  id                   String                 @id @default(uuid())
  schoolId             String
  sourceAcademicYearId String
  targetAcademicYearId String
  createdById          String
  status               ProgressionPlanStatus  @default(draft)
  reviewedById         String?
  reviewedAt           DateTime?
  appliedById          String?
  appliedAt            DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  school               School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sourceAcademicYear   AcademicYear           @relation("ProgressionSourceYear", fields: [sourceAcademicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  targetAcademicYear   AcademicYear           @relation("ProgressionTargetYear", fields: [targetAcademicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy            User                   @relation("ProgressionPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy           User?                  @relation("ProgressionPlanReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  appliedBy            User?                  @relation("ProgressionPlanAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  entries              ProgressionEntry[]
  exceptions           ProgressionException[]

  @@index([schoolId, sourceAcademicYearId, status])
  @@index([schoolId, targetAcademicYearId])
}

model ProgressionEntry {
  id                  String                 @id @default(uuid())
  planId              String
  studentId           String
  sourceEnrollmentId  String
  action              ProgressionAction      @default(manualReview)
  targetGradeLevelId  String?
  targetSchoolClassId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  plan                ProgressionPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  student             Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sourceEnrollment    Enrollment             @relation(fields: [sourceEnrollmentId], references: [id], onDelete: Restrict)
  exceptions          ProgressionException[]

  @@unique([planId, studentId])
  @@index([sourceEnrollmentId])
}

model ProgressionException {
  id             String                     @id @default(uuid())
  planId         String
  entryId        String
  kind           ProgressionExceptionKind
  status         ProgressionExceptionStatus @default(open)
  detectedAt     DateTime                   @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  plan           ProgressionPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  entry          ProgressionEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  resolvedBy     User?                      @relation("ProgressionExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([planId, status])
  @@index([entryId, kind])
}

model PrivacyRequest {
  id                          String                      @id @default(uuid())
  schoolId                    String
  studentId                   String
  requesterUserId             String
  requesterKind               PrivacyRequesterKind
  type                        PrivacyRequestType
  status                      PrivacyRequestStatus        @default(submitted)
  details                     String
  correctionField             StudentCorrectionField?
  correctionValue             String?
  restrictionCategory         PrivacyRestrictionCategory?
  createdAt                   DateTime                    @default(now())
  reviewedAt                  DateTime?
  reviewedById                String?
  reviewReason                String?
  fulfilledAt                 DateTime?
  accessPackage               Json?
  officialCorrectionRequestId String?
  officialCorrectionRequest   StudentCorrectionRequest?   @relation(fields: [officialCorrectionRequestId], references: [id], onDelete: Restrict)
  processingRestrictions      ProcessingRestriction[]
  retentionHolds              RetentionHold[]
  school                      School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student                     Student                     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  requester                   User                        @relation("PrivacyRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  reviewedBy                  User?                       @relation("PrivacyRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([schoolId, status, createdAt])
  @@index([requesterUserId, createdAt])
  @@index([studentId, createdAt])
}

model ProcessingRestriction {
  id               String                     @id @default(uuid())
  schoolId         String
  studentId        String
  privacyRequestId String
  category         PrivacyRestrictionCategory
  status           PrivacyRestrictionState
  effectiveAt      DateTime?
  endedAt          DateTime?
  approvedById     String
  endedById        String?
  createdAt        DateTime                   @default(now())
  school           School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student          Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  privacyRequest   PrivacyRequest             @relation(fields: [privacyRequestId], references: [id], onDelete: Restrict)
  approvedBy       User                       @relation("RestrictionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  endedBy          User?                      @relation("RestrictionEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@unique([privacyRequestId, category])
  @@index([schoolId, studentId, category, status])
}

enum RetentionHoldScope {
  student
  privacyRequest
  issuedDocument
}

model RetentionHold {
  id               String             @id @default(uuid())
  organizationId   String
  scope            RetentionHoldScope
  studentId        String?
  privacyRequestId String?
  issuedDocumentId String?
  reason           String
  createdById      String
  createdAt        DateTime           @default(now())
  releasedById     String?
  releasedAt       DateTime?
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student          Student?           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  privacyRequest   PrivacyRequest?    @relation(fields: [privacyRequestId], references: [id], onDelete: Restrict)
  issuedDocument   IssuedDocument?    @relation(fields: [issuedDocumentId], references: [id], onDelete: Restrict)
  createdBy        User               @relation("RetentionHoldCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy       User?              @relation("RetentionHoldReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([organizationId, scope, releasedAt])
  @@index([studentId, releasedAt])
  @@index([issuedDocumentId, releasedAt])
}
