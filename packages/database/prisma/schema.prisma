generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  owner
  administrator
}

enum SchoolRole {
  administrator
  registrar
  teacher
  approver
}

enum BureauRole {
  viewer
  reportManager
}

enum ReportingPeriodStatus {
  draft
  open
  closed
}

enum ReportingSubmissionStatus {
  draft
  submitted
  approved
  returned
}

enum VerificationResultStatus {
  active
  corrected
  withdrawn
  unavailable
}

enum ResultSetStatus {
  draft
  pending
  published
}

enum TransferStatus {
  requested
  approvedBySendingSchool
  acceptedByReceivingSchool
  rejected
  cancelled
}

enum DocumentType {
  reportCard
  transcript
}

enum DocumentRequestStatus {
  requested
  processing
  ready
  rejected
  cancelled
}

enum DocumentStatus {
  active
  corrected
  withdrawn
}

enum FamilySenderKind {
  guardian
  school
}

enum FamilyConversationRoute {
  teacher
  schoolOffice
}

enum FamilyConversationStatus {
  open
  closed
}

enum GuardianVerificationStatus {
  pending
  verified
  revoked
}

enum EnrollmentStatus {
  draft
  pending
  approved
  withdrawn
}

model Organization {
  id               String                   @id @default(uuid())
  name             String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  schools          School[]
  memberships      OrganizationMembership[]
  bureauAccesses   BureauAccess[]
  reportingPeriods ReportingPeriod[]
}

model School {
  resultSets                    ResultSet[]
  publishedResults              PublishedResult[]
  learningMaterials             LearningMaterial[]
  announcements                 Announcement[]
  id                            String                 @id @default(uuid())
  organizationId                String
  name                          String
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  organization                  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff                         SchoolMembership[]
  academicYears                 AcademicYear[]
  gradeLevels                   GradeLevel[]
  subjects                      Subject[]
  classes                       SchoolClass[]
  enrollments                   Enrollment[]
  teachingAssignments           TeachingAssignment[]
  gradingPeriods                GradingPeriod[]
  assessments                   Assessment[]
  marks                         Mark[]
  gradingScheme                 GradingScheme?
  issuedDocuments               IssuedDocument[]
  outgoingTransfers             TransferRequest[]      @relation("SendingTransfers")
  incomingTransfers             TransferRequest[]      @relation("ReceivingTransfers")
  verifiedGuardianRelationships StudentGuardian[]
  serviceAccess                 SchoolServiceAccess?
  familyConversations           FamilyConversation[]
  reportingRequirements         ReportingRequirement[]
  reportingSubmissions          ReportingSubmission[]
  verificationEvents            VerificationEvent[]
  importJobs                    ImportJob[]
  documentProfile              SchoolDocumentProfile?
  documentRequests             DocumentRequest[]

  @@index([organizationId])
}

model User {
  submittedResultSets          ResultSet[]              @relation("ResultSetSubmittedBy")
  issuedDocuments              IssuedDocument[]
  requestedTransfers           TransferRequest[]
  approvedTransfers            TransferRequest[]        @relation("TransferApprovedBy")
  acceptedTransfers            TransferRequest[]        @relation("TransferAcceptedBy")
  rejectedTransfers            TransferRequest[]        @relation("TransferRejectedBy")
  cancelledTransfers           TransferRequest[]        @relation("TransferCancelledBy")
  correctedDocuments           IssuedDocument[]         @relation("DocumentCorrectedBy")
  withdrawnDocuments           IssuedDocument[]         @relation("DocumentWithdrawnBy")
  publishedResultSets          ResultSet[]              @relation("ResultSetPublishedBy")
  resultCorrections            ResultCorrection[]
  learningMaterials            LearningMaterial[]
  announcements                Announcement[]
  id                           String                   @id @default(uuid())
  email                        String                   @unique
  displayName                  String
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  organizationMemberships      OrganizationMembership[]
  schoolMemberships            SchoolMembership[]
  bureauAccesses               BureauAccess[]
  passwordCredential           PasswordCredential?
  studentAccess                StudentAccess?
  guardianVerifications        StudentGuardian[]        @relation("GuardianVerifiedBy")
  guardianRevocations          StudentGuardian[]        @relation("GuardianRevokedBy")
  schoolServiceUpdates         SchoolServiceAccess[]
  familyMessages               FamilyMessage[]
  teacherConversations         FamilyConversation[]     @relation("FamilyConversationTeacher")
  closedFamilyConversations    FamilyConversation[]     @relation("FamilyConversationClosedBy")
  escalatedFamilyConversations FamilyConversation[]     @relation("FamilyConversationEscalatedBy")
  guardianAccess               GuardianAccess?
  sessions                     Session[]
  supportIdentity              SupportIdentity?
  approvedEnrollments          Enrollment[]             @relation("EnrollmentApprovedBy")
  withdrawnEnrollments         Enrollment[]             @relation("EnrollmentWithdrawnBy")
  createdImportJobs            ImportJob[]
  requestedDocuments           DocumentRequest[]
  notifications                Notification[]
  teachingAssignments          TeachingAssignment[]
  marks                        Mark[]
}

model OrganizationMembership {
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model SchoolMembership {
  userId    String
  schoolId  String
  role      SchoolRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@index([schoolId])
}

model BureauAccess {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           BureauRole
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role, revokedAt])
}

model ReportingPeriod {
  id              String                 @id @default(uuid())
  organizationId  String
  name            String
  startsOn        DateTime               @db.Date
  endsOn          DateTime               @db.Date
  submissionDueOn DateTime               @db.Date
  status          ReportingPeriodStatus  @default(draft)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements    ReportingRequirement[]
  submissions     ReportingSubmission[]

  @@unique([organizationId, name])
  @@index([organizationId, status, startsOn])
}

model ReportingRequirement {
  id                String          @id @default(uuid())
  reportingPeriodId String
  schoolId          String
  createdAt         DateTime        @default(now())
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([reportingPeriodId, schoolId])
  @@index([schoolId])
}

model ReportingSubmission {
  id                String                    @id @default(uuid())
  reportingPeriodId String
  schoolId          String
  status            ReportingSubmissionStatus @default(draft)
  snapshot          Json
  submittedAt       DateTime?
  submittedById     String?
  approvedAt        DateTime?
  approvedById      String?
  returnedAt        DateTime?
  returnedById      String?
  returnReason      String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  reportingPeriod   ReportingPeriod           @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([reportingPeriodId, schoolId])
  @@index([schoolId, status])
  @@index([reportingPeriodId, status])
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String?
  schoolId       String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now())

  @@index([organizationId, occurredAt])
  @@index([schoolId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, resourceType, occurredAt])
}

enum AccessReviewStatus {
  open
  completed
}

enum AccessReviewDecision {
  pending
  confirmed
  revoke
}

enum AccessReviewType {
  organizationMembership
  schoolMembership
  bureauAccess
}

model AccessReview {
  id             String              @id @default(uuid())
  organizationId String
  schoolId       String?
  startedById    String
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  completedById  String?
  status         AccessReviewStatus  @default(open)
  entries        AccessReviewEntry[]

  @@index([organizationId, status, startedAt])
  @@index([schoolId, status, startedAt])
}

model AccessReviewEntry {
  id             String               @id @default(uuid())
  accessReviewId String
  userId         String
  accessType     AccessReviewType
  organizationId String
  schoolId       String?
  currentRole    String
  sourceId       String?
  decision       AccessReviewDecision @default(pending)
  decidedById    String?
  decidedAt      DateTime?
  accessReview   AccessReview         @relation(fields: [accessReviewId], references: [id], onDelete: Cascade)

  @@unique([accessReviewId, accessType, userId, organizationId, schoolId])
  @@index([accessReviewId, decision])
  @@index([userId])
}

enum SupportAccessStatus {
  pending
  approved
  revoked
}

enum SupportAccessScope {
  schoolAdministrationDiagnostics
}

model SupportIdentity {
  userId    String   @id
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportAccessGrant {
  id            String              @id @default(uuid())
  supportUserId String
  schoolId      String
  scope         SupportAccessScope  @default(schoolAdministrationDiagnostics)
  reason        String
  status        SupportAccessStatus @default(pending)
  requestedAt   DateTime            @default(now())
  requestedById String
  approvedAt    DateTime?
  approvedById  String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedById   String?

  @@index([supportUserId, schoolId, status, expiresAt])
  @@index([schoolId, status, requestedAt])
}

enum RetentionCategory {
  messages
  auditEvents
  issuedDocuments
  academicRecords
  enrollmentRecords
}

model RetentionPolicy {
  id             String            @id @default(uuid())
  organizationId String
  category       RetentionCategory
  retentionDays  Int
  updatedById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId, updatedAt])
}

model PasswordCredential {
  userId             String   @id
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AcademicYear {
  resultSets          ResultSet[]
  issuedDocuments     IssuedDocument[]
  documentRequests    DocumentRequest[]
  learningMaterials   LearningMaterial[]
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  startsOn            DateTime             @db.Date
  endsOn              DateTime             @db.Date
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes             SchoolClass[]
  teachingAssignments TeachingAssignment[]
  gradingPeriods      GradingPeriod[]
  enrollments         Enrollment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@index([schoolId, startsOn])
}

model GradeLevel {
  id          String        @id @default(uuid())
  schoolId    String
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes     SchoolClass[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
}

model SchoolClass {
  resultSets          ResultSet[]
  learningMaterials   LearningMaterial[]
  announcements       Announcement[]
  id                  String               @id @default(uuid())
  schoolId            String
  academicYearId      String
  gradeLevelId        String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear         @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel          GradeLevel           @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, academicYearId, gradeLevelId, name])
  @@unique([id, schoolId])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, gradeLevelId])
}

model Student {
  transferRequests    TransferRequest[]
  issuedDocuments     IssuedDocument[]
  documentRequests    DocumentRequest[]
  publishedResults    PublishedResult[]
  id                  String               @id @default(uuid())
  studentReference    String               @unique
  givenName           String
  familyName          String?
  dateOfBirth         DateTime?            @db.Date
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  guardians           StudentGuardian[]
  familyConversations FamilyConversation[]
  studentAccess       StudentAccess?
  enrollments         Enrollment[]
  marks               Mark[]
}

model StudentAccess {
  id        String   @id @default(uuid())
  userId    String   @unique
  studentId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Guardian {
  id                  String               @id @default(uuid())
  name                String
  phone               String?
  email               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  students            StudentGuardian[]
  access              GuardianAccess?
  familyConversations FamilyConversation[]
}

model GuardianAccess {
  id         String   @id @default(uuid())
  userId     String   @unique
  guardianId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
}

model StudentGuardian {
  studentId            String
  guardianId           String
  relationship         String
  verificationStatus   GuardianVerificationStatus @default(pending)
  verificationSchoolId String?
  verifiedAt           DateTime?
  verifiedById         String?
  revokedAt            DateTime?
  revokedById          String?
  revocationReason     String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  student              Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian             Guardian                   @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  verificationSchool   School?                    @relation(fields: [verificationSchoolId], references: [id], onDelete: Restrict)
  verifiedBy           User?                      @relation("GuardianVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  revokedBy            User?                      @relation("GuardianRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@index([verificationSchoolId, verificationStatus])
}

model Enrollment {
  receivingTransfer TransferRequest?  @relation("TransferDestination")
  sourceTransfers   TransferRequest[] @relation("TransferSource")
  publishedResults  PublishedResult[]
  id                String            @id @default(uuid())
  studentId         String
  schoolId          String
  academicYearId    String
  gradeLevelId      String
  schoolClassId     String?
  status            EnrollmentStatus  @default(draft)
  approvedAt        DateTime?
  approvedById      String?
  withdrawnAt       DateTime?
  withdrawnById     String?
  withdrawalReason  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear      AcademicYear      @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel        GradeLevel        @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass       SchoolClass?      @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Restrict)
  approvedBy        User?             @relation("EnrollmentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  withdrawnBy       User?             @relation("EnrollmentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  marks             Mark[]

  @@unique([studentId, schoolId, academicYearId])
  @@unique([id, schoolId, studentId])
  @@index([schoolId, academicYearId, status])
  @@index([schoolId, gradeLevelId])
  @@index([approvedById])
  @@index([withdrawnById])
}

model Subject {
  resultSets          ResultSet[]
  learningMaterials   LearningMaterial[]
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  code                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([id, schoolId])
}

model LearningMaterial {
  id               String       @id @default(uuid())
  schoolId         String
  academicYearId   String
  schoolClassId    String
  subjectId        String
  title            String
  description      String?
  resourceType     String
  resourceLocation String
  publishedAt      DateTime?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass      SchoolClass  @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject          Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy        User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, academicYearId, schoolClassId, publishedAt])
  @@index([createdById, schoolId])
}

model Announcement {
  id            String       @id @default(uuid())
  schoolId      String
  schoolClassId String?
  title         String
  body          String
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolClass   SchoolClass? @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, publishedAt, expiresAt])
  @@index([schoolClassId, schoolId])
  @@index([createdById, schoolId])
}

model TeachingAssignment {
  id             String       @id @default(uuid())
  schoolId       String
  userId         String
  academicYearId String
  schoolClassId  String
  subjectId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass    SchoolClass  @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([userId, schoolClassId, subjectId, academicYearId])
  @@index([schoolId, academicYearId, userId])
  @@index([schoolId, schoolClassId, subjectId])
}

model GradingPeriod {
  resultSets     ResultSet[]
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String
  startsOn       DateTime     @db.Date
  endsOn         DateTime     @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  assessments    Assessment[]

  @@unique([schoolId, academicYearId, name])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, startsOn])
}

model Assessment {
  id              String        @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  name            String
  maximumScore    Decimal       @db.Decimal(8, 2)
  weight          Decimal       @db.Decimal(5, 2)
  position        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass   @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject       @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  marks           Mark[]

  @@unique([id, schoolId])
  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, name], map: "Assessment_context_name_key")
  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, position], map: "Assessment_context_position_key")
  @@index([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId])
}

model Mark {
  id           String     @id @default(uuid())
  schoolId     String
  studentId    String
  enrollmentId String
  assessmentId String
  score        Decimal    @db.Decimal(8, 2)
  recordedById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment   Enrollment @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  assessment   Assessment @relation(fields: [assessmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  recordedBy   User       @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, assessmentId])
  @@index([schoolId, assessmentId])
  @@index([schoolId, studentId])
}

model GradingScheme {
  id        String      @id @default(uuid())
  schoolId  String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  bands     GradeBand[]
}

model GradeBand {
  id                String        @id @default(uuid())
  gradingSchemeId   String
  label             String
  minimumPercentage Decimal       @db.Decimal(5, 2)
  gradingScheme     GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@unique([gradingSchemeId, label])
  @@unique([gradingSchemeId, minimumPercentage])
  @@index([gradingSchemeId, minimumPercentage])
}

model ResultSet {
  id              String            @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  status          ResultSetStatus   @default(draft)
  submittedAt     DateTime?
  submittedById   String?
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear      @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod     @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass       @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject           @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)
  submittedBy     User?             @relation("ResultSetSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  publishedBy     User?             @relation("ResultSetPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  results         PublishedResult[]

  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId], map: "ResultSet_context_key")
  @@unique([id, schoolId])
  @@index([schoolId, status])
}

model PublishedResult {
  id                String             @id @default(uuid())
  schoolId          String
  resultSetId       String
  studentId         String
  enrollmentId      String
  percentage        Decimal            @db.Decimal(5, 2)
  gradeLabel        String
  currentPercentage Decimal            @db.Decimal(5, 2)
  currentGradeLabel String
  createdAt         DateTime           @default(now())
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  resultSet         ResultSet          @relation(fields: [resultSetId, schoolId], references: [id, schoolId], onDelete: Restrict)
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment        Enrollment         @relation(fields: [enrollmentId, schoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  corrections       ResultCorrection[]

  @@unique([resultSetId, enrollmentId])
  @@unique([id, schoolId])
  @@index([schoolId, studentId])
}

model ResultCorrection {
  id                 String          @id @default(uuid())
  schoolId           String
  publishedResultId  String
  previousPercentage Decimal         @db.Decimal(5, 2)
  previousGradeLabel String
  newPercentage      Decimal         @db.Decimal(5, 2)
  newGradeLabel      String
  reason             String
  actorId            String
  effectiveAt        DateTime        @default(now())
  publishedResult    PublishedResult @relation(fields: [publishedResultId, schoolId], references: [id, schoolId], onDelete: Restrict)
  actor              User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([schoolId, publishedResultId, effectiveAt])
}

model IssuedDocument {
  id                    String              @id @default(uuid())
  studentId             String
  schoolId              String
  academicYearId        String
  documentType          DocumentType
  snapshot              Json                @default("{}")
  supersedesId          String?             @unique
  correctionReason      String?
  correctedById         String?
  correctedAt           DateTime?
  withdrawalReason      String?
  withdrawnById         String?
  withdrawnAt           DateTime?
  verificationReference String              @unique
  status                DocumentStatus      @default(active)
  issuedAt              DateTime            @default(now())
  issuedById            String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  student               Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear        @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  issuedBy              User                @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  correctedBy           User?               @relation("DocumentCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)
  withdrawnBy           User?               @relation("DocumentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  supersedes            IssuedDocument?     @relation("DocumentVersion", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacedBy            IssuedDocument?     @relation("DocumentVersion")
  verificationEvents    VerificationEvent[]
  documentRequest       DocumentRequest?

  @@index([schoolId, studentId, issuedAt])
  @@index([schoolId, issuedAt])
}

model VerificationEvent {
  id               String                   @id @default(uuid())
  issuedDocumentId String?
  schoolId         String?
  resultStatus     VerificationResultStatus
  occurredAt       DateTime                 @default(now())
  issuedDocument   IssuedDocument?          @relation(fields: [issuedDocumentId], references: [id], onDelete: SetNull)
  school           School?                  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, occurredAt, resultStatus])
}

model TransferRequest {
  id                    String         @id @default(uuid())
  studentId             String
  sendingSchoolId       String
  receivingSchoolId     String
  sourceEnrollmentId    String
  status                TransferStatus @default(requested)
  transferPackage       Json
  requestedById         String
  requestedAt           DateTime       @default(now())
  sendingApprovedById   String?
  sendingApprovedAt     DateTime?
  acceptedById          String?
  acceptedAt            DateTime?
  rejectedById          String?
  rejectedAt            DateTime?
  rejectionReason       String?
  cancelledById         String?
  cancelledAt           DateTime?
  cancellationReason    String?
  completedAt           DateTime?
  receivingEnrollmentId String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  student               Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sendingSchool         School         @relation("SendingTransfers", fields: [sendingSchoolId], references: [id], onDelete: Restrict)
  receivingSchool       School         @relation("ReceivingTransfers", fields: [receivingSchoolId], references: [id], onDelete: Restrict)
  sourceEnrollment      Enrollment     @relation("TransferSource", fields: [sourceEnrollmentId, sendingSchoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)
  requestedBy           User           @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  sendingApprovedBy     User?          @relation("TransferApprovedBy", fields: [sendingApprovedById], references: [id], onDelete: Restrict)
  acceptedBy            User?          @relation("TransferAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  rejectedBy            User?          @relation("TransferRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  cancelledBy           User?          @relation("TransferCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  receivingEnrollment   Enrollment?    @relation("TransferDestination", fields: [receivingEnrollmentId, receivingSchoolId, studentId], references: [id, schoolId, studentId], onDelete: Restrict)

  @@unique([receivingEnrollmentId, receivingSchoolId, studentId])
  @@index([sendingSchoolId, status, requestedAt])
  @@index([receivingSchoolId, status, requestedAt])
  @@index([studentId, requestedAt])
}

model SchoolServiceAccess {
  id                  String    @id @default(uuid())
  schoolId            String    @unique
  parentPortalEnabled Boolean   @default(false)
  enabledAt           DateTime?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  updatedBy           User?     @relation(fields: [updatedById], references: [id], onDelete: Restrict)
}

model FamilyConversation {
  id            String                   @id @default(uuid())
  schoolId      String
  studentId     String
  guardianId    String
  route         FamilyConversationRoute
  teacherUserId String?
  status        FamilyConversationStatus @default(open)
  closedAt      DateTime?
  closedById    String?
  escalatedAt   DateTime?
  escalatedById String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student       Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian      Guardian                 @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  teacher       User?                    @relation("FamilyConversationTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  closedBy      User?                    @relation("FamilyConversationClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  escalatedBy   User?                    @relation("FamilyConversationEscalatedBy", fields: [escalatedById], references: [id], onDelete: Restrict)
  messages      FamilyMessage[]

  @@index([guardianId, createdAt])
  @@index([schoolId, route, status, createdAt])
  @@index([teacherUserId, status, createdAt])
}

model FamilyMessage {
  id             String             @id @default(uuid())
  conversationId String
  senderUserId   String
  senderKind     FamilySenderKind   @default(guardian)
  body           String
  createdAt      DateTime           @default(now())
  readAt         DateTime?
  conversation   FamilyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
}

enum ImportJobType {
  studentRegistration
}

enum ImportJobStatus {
  uploaded
  validated
  invalid
  applied
  cancelled
}

enum ImportIssueSeverity {
  error
  warning
}

model ImportJob {
  id               String          @id @default(uuid())
  schoolId         String
  createdById      String
  type             ImportJobType   @default(studentRegistration)
  status           ImportJobStatus @default(uploaded)
  originalFileName String?
  totalRows        Int             @default(0)
  validRows        Int             @default(0)
  invalidRows      Int             @default(0)
  normalizedRows   Json            @default("[]")
  createdAt        DateTime        @default(now())
  validatedAt      DateTime?
  appliedAt        DateTime?
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  issues           ImportRowIssue[]

  @@index([schoolId, createdAt])
}

model ImportRowIssue {
  id        String              @id @default(uuid())
  jobId     String
  rowNumber Int
  severity  ImportIssueSeverity
  code      String
  message   String
  job       ImportJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber])
}
model Notification {
  id           String    @id @default(uuid())
  userId       String
  type         String
  title        String
  message      String
  resourceType String?
  resourceId   String?
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}
model SchoolDocumentProfile {
  schoolId       String   @id
  officialName   String?
  addressLine    String?
  city           String?
  region         String?
  phone          String?
  email          String?
  website        String?
  documentFooter String?
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}
model DocumentRequest {
  id               String                @id @default(uuid())
  studentId        String
  schoolId         String
  academicYearId   String
  documentType     DocumentType
  status           DocumentRequestStatus @default(requested)
  requestedById    String
  requestedAt      DateTime              @default(now())
  processingAt     DateTime?
  readyAt          DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  cancelledAt      DateTime?
  issuedDocumentId String?               @unique
  student          Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear          @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  requestedBy      User                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  issuedDocument   IssuedDocument?       @relation(fields: [issuedDocumentId], references: [id], onDelete: Restrict)

  @@index([studentId, requestedAt])
  @@index([schoolId, status, requestedAt])
}
