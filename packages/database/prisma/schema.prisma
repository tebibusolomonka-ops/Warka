generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  owner
  administrator
}

enum SchoolRole {
  administrator
  registrar
  teacher
  approver
}

enum EnrollmentStatus {
  draft
  pending
  approved
  withdrawn
}

model Organization {
  id          String                   @id @default(uuid())
  name        String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  schools     School[]
  memberships OrganizationMembership[]
}

model School {
  id                  String               @id @default(uuid())
  organizationId      String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff               SchoolMembership[]
  academicYears       AcademicYear[]
  gradeLevels         GradeLevel[]
  subjects            Subject[]
  classes             SchoolClass[]
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  gradingPeriods      GradingPeriod[]
  assessments         Assessment[]

  @@index([organizationId])
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  displayName             String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organizationMemberships OrganizationMembership[]
  schoolMemberships       SchoolMembership[]
  passwordCredential      PasswordCredential?
  sessions                Session[]
  approvedEnrollments     Enrollment[]             @relation("EnrollmentApprovedBy")
  withdrawnEnrollments    Enrollment[]             @relation("EnrollmentWithdrawnBy")
  teachingAssignments     TeachingAssignment[]
}

model OrganizationMembership {
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model SchoolMembership {
  userId    String
  schoolId  String
  role      SchoolRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@index([schoolId])
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AcademicYear {
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  startsOn            DateTime             @db.Date
  endsOn              DateTime             @db.Date
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes             SchoolClass[]
  teachingAssignments TeachingAssignment[]
  gradingPeriods      GradingPeriod[]
  enrollments         Enrollment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@index([schoolId, startsOn])
}

model GradeLevel {
  id          String        @id @default(uuid())
  schoolId    String
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes     SchoolClass[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
}

model SchoolClass {
  id                  String               @id @default(uuid())
  schoolId            String
  academicYearId      String
  gradeLevelId        String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear         @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel          GradeLevel           @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, academicYearId, gradeLevelId, name])
  @@unique([id, schoolId])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, gradeLevelId])
}

model Student {
  id               String            @id @default(uuid())
  studentReference String            @unique
  givenName        String
  familyName       String?
  dateOfBirth      DateTime?         @db.Date
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  guardians        StudentGuardian[]
  enrollments      Enrollment[]
}

model Guardian {
  id        String            @id @default(uuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  students  StudentGuardian[]
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String
  schoolId       String
  academicYearId String
  gradeLevelId   String
  schoolClassId  String?
  status         EnrollmentStatus @default(draft)
  approvedAt     DateTime?
  approvedById   String?
  withdrawnAt    DateTime?
  withdrawnById  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear     @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel     GradeLevel       @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass    SchoolClass?     @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Restrict)
  approvedBy     User?            @relation("EnrollmentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  withdrawnBy    User?            @relation("EnrollmentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)

  @@unique([studentId, schoolId, academicYearId])
  @@index([schoolId, academicYearId, status])
  @@index([schoolId, gradeLevelId])
  @@index([approvedById])
  @@index([withdrawnById])
}

model Subject {
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  code                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  assessments         Assessment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([id, schoolId])
}

model TeachingAssignment {
  id             String       @id @default(uuid())
  schoolId       String
  userId         String
  academicYearId String
  schoolClassId  String
  subjectId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass    SchoolClass  @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([userId, schoolClassId, subjectId, academicYearId])
  @@index([schoolId, academicYearId, userId])
  @@index([schoolId, schoolClassId, subjectId])
}

model GradingPeriod {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String
  startsOn       DateTime     @db.Date
  endsOn         DateTime     @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  assessments    Assessment[]

  @@unique([schoolId, academicYearId, name])
  @@unique([id, schoolId, academicYearId])
  @@index([schoolId, academicYearId, startsOn])
}

model Assessment {
  id              String        @id @default(uuid())
  schoolId        String
  academicYearId  String
  gradingPeriodId String
  schoolClassId   String
  subjectId       String
  name            String
  maximumScore    Decimal       @db.Decimal(8, 2)
  weight          Decimal       @db.Decimal(5, 2)
  position        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  schoolClass     SchoolClass   @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject         Subject       @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, name], map: "Assessment_context_name_key")
  @@unique([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId, position], map: "Assessment_context_position_key")
  @@index([schoolId, academicYearId, gradingPeriodId, schoolClassId, subjectId])
}
