  progressionEntries ProgressionEntry[]

  @@unique([studentId, schoolId, academicYearId])
  @@unique([id, schoolId, studentId])
  @@index([schoolId, academicYearId, status])
  @@index([schoolId, gradeLevelId])
  @@index([approvedById])
  @@index([withdrawnById])
}

model EnrollmentCorrectionRequest {
  id                        String                  @id @default(uuid())
  enrollmentId              String
  schoolId                  String
  academicYearId            String
  previousGradeLevelId      String
  previousSchoolClassId     String?
  proposedGradeLevelId      String
  proposedSchoolClassId     String?
  reason                    String
  status                    CorrectionRequestStatus @default(pending)
  requestedById             String
  requestedAt               DateTime                @default(now())
  reviewReason   String?
  effectiveAt    DateTime?
  reviewedAt                DateTime?
  reviewedById              String?
  enrollment                Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  school                    School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  requestedBy               User                    @relation("EnrollmentCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy                User?                   @relation("EnrollmentCorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([schoolId, status, requestedAt])
  @@index([enrollmentId, requestedAt])
}

model EnrollmentHistoryEvent {
  id                       String                @id @default(uuid())
  enrollmentId             String
  eventType                EnrollmentHistoryType
  effectiveAt              DateTime
  performedById            String?
