  @@index([schoolId, publishedAt, expiresAt])
  @@index([schoolClassId, schoolId])
  @@index([createdById, schoolId])
}

model TeachingAssignment {
  meetingRequests       ParentTeacherMeetingRequest[]
  courseworkAssignments CourseworkAssignment[]
  timetableEntries      ClassTimetableEntry[]
  attendanceSessions    AttendanceSession[]
  id                    String                        @id @default(uuid())
  schoolId              String
  userId                String
  academicYearId        String
  schoolClassId         String
  subjectId             String
  startsAt              DateTime                      @default(now())
  endsAt                DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  school                School                        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear                  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass           SchoolClass                   @relation(fields: [schoolClassId, schoolId, academicYearId], references: [id, schoolId, academicYearId], onDelete: Restrict)
  subject               Subject                       @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([id, schoolId, academicYearId, schoolClassId, subjectId], map: "TeachingAssignment_timetable_scope_key")
  @@index([schoolId, academicYearId, userId])
  @@index([schoolId, schoolClassId, subjectId])
}

enum ParentTeacherMeetingStatus {
  requested
  scheduled
  declined
  cancelled
  completed
}

enum MeetingMethod {
  inPerson
  phone
  online
}

model TeacherMeetingAvailability {
  id        String        @id @default(uuid())
  schoolId  String
  teacherId String
  startsAt  DateTime
  endsAt    DateTime
  method    MeetingMethod
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacher   User          @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([schoolId, teacherId, startsAt])
}

model ParentTeacherMeetingRequest {
  events               MeetingEvent[]
  id                   String                     @id @default(uuid())
  schoolId             String
  studentId            String
  guardianId           String
  guardianUserId       String
  teacherId            String
  teachingAssignmentId String
  topic                String                     @db.VarChar(300)
  status               ParentTeacherMeetingStatus @default(requested)
  scheduledStartAt     DateTime?
  scheduledEndAt       DateTime?
  meetingMethod        MeetingMethod?
  schoolLocation       String?                    @db.VarChar(200)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  school               School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student              Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian             Guardian                   @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  guardianUser         User                       @relation("MeetingGuardianUser", fields: [guardianUserId], references: [id], onDelete: Restrict)
  teacher              User                       @relation("MeetingTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  teachingAssignment   TeachingAssignment         @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)

  @@index([schoolId, teacherId, status, createdAt])
  @@index([schoolId, teacherId, scheduledStartAt])
  @@index([guardianUserId, studentId, createdAt])
}

enum MeetingEventKind {
  requested
  scheduled
  rescheduled
  declined
  cancelled
  completed
}

enum SchoolEventStatus {
  draft
  published
  cancelled
  completed
}

model SchoolEvent {
  responses      EventResponse[]
  rsvpEnabled    Boolean              @default(false)
  attachments    EventAttachment[]
  audience       SchoolEventAudience?
  id             String               @id @default(uuid())
  schoolId       String
  createdById    String
  title          String               @db.VarChar(200)
  description    String               @db.Text
  startsAt       DateTime
  endsAt         DateTime
  schoolLocation String?              @db.VarChar(200)
  status         SchoolEventStatus    @default(draft)
  publishedAt    DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy      User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, status, startsAt])
}

enum EventResponseStatus {
  going
  notGoing
}

model EventResponse {
  id               String                 @id @default(uuid())
  eventId          String
  schoolId         String
  respondentUserId String
  subjectKey       String                 @db.VarChar(100)
  studentId        String?
  status           EventResponseStatus
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  event            SchoolEvent            @relation(fields: [eventId, schoolId], references: [id, schoolId], onDelete: Restrict)
  respondent       User                   @relation(fields: [respondentUserId], references: [id], onDelete: Restrict)
  student          Student?               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  history          EventResponseHistory[]

  @@unique([eventId, respondentUserId, subjectKey])
  @@index([schoolId, eventId, status])
}

model EventResponseHistory {
  id             String               @id @default(uuid())
  responseId     String
  actorId        String
  previousStatus EventResponseStatus?
  newStatus      EventResponseStatus
  createdAt      DateTime             @default(now())
  response       EventResponse        @relation(fields: [responseId], references: [id], onDelete: Restrict)
  actor          User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([responseId, createdAt])
}

model EventAttachment {
  id          String      @id @default(uuid())
  schoolId    String
  eventId     String
  fileAssetId String      @unique
  createdById String
  createdAt   DateTime    @default(now())
  removedAt   DateTime?
  event       SchoolEvent @relation(fields: [eventId, schoolId], references: [id, schoolId], onDelete: Restrict)
  fileAsset   FileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, eventId, removedAt])
}

enum SchoolEventAudienceScope {
  wholeSchool
  students
  guardians
  staff
  grade
  class
}

model SchoolEventAudience {
  id            String                   @id @default(uuid())
  eventId       String                   @unique
  schoolId      String
  scope         SchoolEventAudienceScope
  gradeLevelId  String?
  schoolClassId String?
  event         SchoolEvent              @relation(fields: [eventId, schoolId], references: [id, schoolId], onDelete: Restrict)
  gradeLevel    GradeLevel?              @relation(fields: [gradeLevelId, schoolId], references: [id, schoolId], onDelete: Restrict)
  schoolClass   SchoolClass?             @relation(fields: [schoolClassId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([eventId, schoolId])
  @@index([schoolId, scope])
}

model MeetingEvent {
  id              String                      @id @default(uuid())
  requestId       String
  actorId         String
